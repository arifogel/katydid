load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# BUILD file for @scarab (github.com/project8/scarab), the common utility library shared by
# Nymph, Cicada, and other Project 8 software (configuration parsing, logging, and related
# infrastructure).
#
# Scarab's optional MessagePack configuration codec is not built here - Katydid's
# configuration only uses Scarab's JSON and YAML codecs.

package(default_visibility = ["//visibility:public"])

# Scarab's version and build metadata are normally filled in by CMake at configure time;
# substituted here the same way, from Scarab's own VERSION file and pinned commit.
genrule(
    name = "scarab_version_cc",
    srcs = ["library/utility/scarab_version.cc.in"],
    outs = ["scarab_version.cc"],
    cmd = """
        sed -e 's/@Scarab_VERSION_MAJOR@/1/' \
            -e 's/@Scarab_VERSION_MINOR@/6/' \
            -e 's/@Scarab_VERSION_PATCH@/3/' \
            -e 's/@Scarab_VERSION@/"1.6.3"/' \
            -e 's/@Scarab_PACKAGE_NAME@/"Scarab"/' \
            -e 's/@Scarab_GIT_COMMIT@/"ef2af248c5db7c92c84952a57759ba0f145f6cd4"/' \
            $< > $@
    """,
)

# Exposes headers separately from the compiled library, same pattern used elsewhere in this
# repo for a shared-library module (e.g. //Source/Utility:katydid_utility_headers) - lets the
# cc_import below propagate headers without depending on the compiled .so it also wraps.
cc_library(
    name = "scarab_headers",
    hdrs = glob([
        "library/utility/*.hh",
        "library/logger/*.hh",
        "library/param/*.hh",
        "library/param/codec/json/*.hh",
        "library/param/codec/yaml/*.hh",
        "library/authentication/*.hh",
    ]),
    includes = [
        "library/authentication",
        "library/logger",
        "library/param",
        "library/param/codec/json",
        "library/param/codec/yaml",
        "library/utility",
    ],
    deps = [
        "@rapidjson",
        "@system_libs//:boost",
        "@yaml_cpp",
    ],
)

# A real, standalone .so, matching the CMake build's own libScarab_Nymph_Katydid.so: the CMake
# build never statically links this module into anything, so REGISTER_PARAM_INPUT_CODEC/
# REGISTER_PARAM_OUTPUT_CODEC's own static registrar constructors (in param_json.cc,
# param_yaml.cc) run exactly once, when this one .so loads.
cc_binary(
    name = "libscarab.so",
    srcs = [
        "library/authentication/authentication.cc",
        "library/logger/logger.cc",
        "library/param/codec/json/param_json.cc",
        "library/param/codec/yaml/param_yaml.cc",
        "library/param/configurator.cc",
        "library/param/global_config.cc",
        "library/param/param.cc",
        "library/param/param_codec.cc",
        "library/param/parsable.cc",
        "library/param/parser.cc",
        "library/utility/cancelable.cc",
        "library/utility/digital.cc",
        "library/utility/error.cc",
        "library/utility/path.cc",
        "library/utility/time.cc",
        "library/utility/typename.cc",
        ":scarab_version_cc",
    ],
    defines = [
        "RAPIDJSON_FILE_BUFFER_SIZE=65536",
        "USE_CODEC_JSON",
        "USE_CPP11",
    ],
    linkshared = True,
    deps = [
        ":scarab_headers",
        "@rapidjson",
        "@system_libs//:boost",
        "@yaml_cpp",
    ],
)

# Wraps the .so above so consumers link against it as a genuine runtime dependency. Keeps the
# name scarab: every existing consumer's own deps entry needs no change.
cc_import(
    name = "scarab",
    shared_library = ":libscarab.so",
    deps = [":scarab_headers"],
)
