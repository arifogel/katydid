load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

# BUILD file for @nymph (github.com/project8/nymph), the processing-framework library that
# Katydid is built on top of (processors, data objects, the run-time application/configuration
# system).
#
# Nymph's Python bindings are not built here - Katydid does not use them.

package(default_visibility = ["//visibility:public"])

# Headers plus everything a consumer's own compilation needs to see (includes, defines) -- the
# only target anything outside this package actually depends on for compile-time visibility.
# cc_shared_library itself has no defines/includes/hdrs attribute at all, so these have to
# live here, not on nymph_lib below.
#
# deps on @scarab//:scarab_headers, not @scarab itself: cc_shared_library provides no CcInfo
# at all, so a plain cc_library (this one) can never depend on one directly -- only another
# cc_shared_library can, via dynamic_deps, and only for the runtime link, not headers.
cc_library(
    name = "nymph_headers",
    hdrs = glob([
        "Library/Utility/*.hh",
        "Library/Data/*.hh",
        "Library/Processor/*.hh",
        "Library/IO/*.hh",
        "Library/Application/*.hh",
    ]),
    defines = ["USE_CPP11"],
    includes = [
        "Library/Application",
        "Library/Data",
        "Library/IO",
        "Library/Processor",
        "Library/Utility",
    ],
    deps = [
        "@scarab//:scarab_headers",
        "@system_libs//:boost",
    ],
)

# The actual compiled code. cc_shared_library's own deps attribute whole-archives everything
# listed here into the shared library unconditionally. Not depended on directly by anything
# outside this package -- only :nymph_headers (for headers) and :nymph (for the runtime link)
# are.
cc_library(
    name = "nymph_lib",
    srcs = [
        "Library/Application/KTApplication.cc",
        "Library/Application/KTCommandLineHandler.cc",
        "Library/Application/KTConfigurator.cc",
        "Library/Application/KTDataQueueProcessor.cc",
        "Library/Application/KTFilenameParsers.cc",
        "Library/Application/KTPrintDataStructure.cc",
        "Library/Application/KTProcessorToolbox.cc",
        "Library/Application/KTRunNymph.cc",
        "Library/Application/KTThroughputProfiler.cc",
        "Library/Data/KTApplyCut.cc",
        "Library/Data/KTCut.cc",
        "Library/Data/KTCutFilter.cc",
        "Library/Data/KTCutStatus.cc",
        "Library/Data/KTData.cc",
        "Library/IO/KTReader.cc",
        "Library/IO/KTWriter.cc",
        "Library/Processor/KTPrimaryProcessor.cc",
        "Library/Processor/KTProcessor.cc",
        "Library/Processor/KTSignal.cc",
        "Library/Processor/KTSignalWrapper.cc",
        "Library/Processor/KTSlotWrapper.cc",
        "Library/Utility/KTCacheDirectory.cc",
        "Library/Utility/KTConfigurable.cc",
        "Library/Utility/KTDirectory.cc",
        "Library/Utility/KTEventLoop.cc",
        "Library/Utility/KTException.cc",
        "Library/Utility/KTLogger.cc",
        "Library/Utility/KTTime.cc",
    ],
    deps = [":nymph_headers"],
)

# A real, standalone .so, matching the CMake build's own libNymph_Katydid.so. Keeps the name
# nymph: every existing consumer's own deps entry for headers is unaffected (still
# @nymph//:nymph_headers); dynamic_deps carries the genuine runtime dependency on libscarab.so.
cc_shared_library(
    name = "nymph",
    dynamic_deps = ["@scarab"],
    shared_lib_name = "libnymph.so",
    deps = [":nymph_lib"],
)
