load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# BUILD file for @nymph (github.com/project8/nymph), the processing-framework library that
# Katydid is built on top of (processors, data objects, the run-time application/configuration
# system).
#
# Nymph's Python bindings are not built here - Katydid does not use them.

package(default_visibility = ["//visibility:public"])

# Exposes headers separately from the compiled library, same pattern used elsewhere in this
# repo for a shared-library module (e.g. //Source/Utility:katydid_utility_headers).
cc_library(
    name = "nymph_headers",
    hdrs = glob([
        "Library/Utility/*.hh",
        "Library/Data/*.hh",
        "Library/Processor/*.hh",
        "Library/IO/*.hh",
        "Library/Application/*.hh",
    ]),
    includes = [
        "Library/Application",
        "Library/Data",
        "Library/IO",
        "Library/Processor",
        "Library/Utility",
    ],
    deps = [
        "@scarab",
        "@system_libs//:boost",
    ],
)

# A real, standalone .so, matching the CMake build's own libNymph_Katydid.so.
cc_binary(
    name = "libnymph.so",
    srcs = [
        "Library/Application/KTApplication.cc",
        "Library/Application/KTCommandLineHandler.cc",
        "Library/Application/KTConfigurator.cc",
        "Library/Application/KTDataQueueProcessor.cc",
        "Library/Application/KTFilenameParsers.cc",
        "Library/Application/KTPrintDataStructure.cc",
        "Library/Application/KTProcessorToolbox.cc",
        "Library/Application/KTRunNymph.cc",
        "Library/Application/KTThroughputProfiler.cc",
        "Library/Data/KTApplyCut.cc",
        "Library/Data/KTCut.cc",
        "Library/Data/KTCutFilter.cc",
        "Library/Data/KTCutStatus.cc",
        "Library/Data/KTData.cc",
        "Library/IO/KTReader.cc",
        "Library/IO/KTWriter.cc",
        "Library/Processor/KTPrimaryProcessor.cc",
        "Library/Processor/KTProcessor.cc",
        "Library/Processor/KTSignal.cc",
        "Library/Processor/KTSignalWrapper.cc",
        "Library/Processor/KTSlotWrapper.cc",
        "Library/Utility/KTCacheDirectory.cc",
        "Library/Utility/KTConfigurable.cc",
        "Library/Utility/KTDirectory.cc",
        "Library/Utility/KTEventLoop.cc",
        "Library/Utility/KTException.cc",
        "Library/Utility/KTLogger.cc",
        "Library/Utility/KTTime.cc",
    ],
    defines = ["USE_CPP11"],
    linkshared = True,
    deps = [
        ":nymph_headers",
        "@scarab",
        "@system_libs//:boost",
    ],
)

# Wraps the .so above so consumers link against it as a genuine runtime dependency. Keeps the
# name nymph: every existing consumer's own deps entry needs no change.
#
# deps on @scarab directly: libnymph.so genuinely needs libscarab.so at runtime, but cc_import
# doesn't see through the .so it wraps to discover that on its own -- a consumer of :nymph
# that doesn't also depend on @scarab directly needs this told explicitly, the same issue
# fixed for root_dict_import/katydid_utility.
cc_import(
    name = "nymph",
    shared_library = ":libnymph.so",
    deps = [
        ":nymph_headers",
        "@scarab",
    ],
)
