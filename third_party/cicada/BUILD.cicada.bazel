load("@katydid//tools:root_dictionary.bzl", "root_dictionary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

# BUILD file for @cicada (github.com/Helium6CRES/cicada), Katydid's classifier-results data
# format library.
#
# Cicada supports two build configurations, controlled by whether classes live under a
# "KT"-prefixed namespace; Katydid's configuration uses the non-namespaced variant, so the
# KTROOTData/CicadaKTDict half of Cicada's own build is not built here. Cicada's optional Python
# bindings are not built either - Katydid does not use them.
#
# Cicada does not depend on Nymph - only on Scarab (for logging and reflection utilities) and
# ROOT. Per readelf -d on the CMake reference build's libCicada_Katydid.so, its NEEDED list
# has ROOT and system libraries only, no Scarab: everything Cicada's headers use from Scarab
# resolves at compile time (inline/template code), so the link needs no libscarab.so at
# runtime, even though Cicada's headers still need Scarab's headers to compile.

package(default_visibility = ["//visibility:public"])

# Referenced by label from Source/Executables/Main/root_include_path_launcher.bzl, so Cling's
# autoparse of the dictionary payload (embedded via -inlineInputHeader) can resolve every
# #include the payload contains -- not just _CROOTData.hh's FileEntry lookup (autoloading),
# but CMemberVariables.hh and friends too (autoparsing the payload text). Matches
# root_dictionary's "headers" list below exactly.
exports_files([
    "Library/_CROOTData.hh",
    "Library/CClassifierResultsData.hh",
    "Library/CMemberVariables.hh",
    "Library/CMTEWithClassifierResultsData.hh",
    "Library/CProcessedMPTData.hh",
    "Library/CROOTData.hh",
])

# Headers plus everything a consumer's compilation needs to see (includes, defines) -- the
# only target anything outside this package depends on for compile-time visibility.
# cc_shared_library has no defines/includes/hdrs attribute, so these live here, not on
# cicada_lib below.
#
# Depends on @scarab//:scarab_headers, not @scarab: cc_shared_library provides no CcInfo, so
# a plain cc_library can't depend on one directly -- only another cc_shared_library can, via
# dynamic_deps, and only for the runtime link, not headers. (Cicada needs Scarab's headers
# regardless of whether the .so needs libscarab.so at runtime -- see the top comment.)
cc_library(
    name = "cicada_headers",
    hdrs = glob(["Library/*.hh"]) + [
        # CROOTData.cc includes _CROOTData.cc directly, an older C++ idiom for splitting a
        # class's implementation across multiple files without compiling each one separately.
        # It needs to be visible to the compiler like a header, even though it is a .cc file.
        "Library/_CROOTData.cc",
    ],
    defines = ["USE_CPP11"],
    includes = ["Library"],
    deps = [
        "@root",
        "@scarab//:scarab_headers",
    ],
)

root_dictionary(
    name = "CicadaDict",
    headers = [
        "Library/_CROOTData.hh",
        "Library/CClassifierResultsData.hh",
        "Library/CMemberVariables.hh",
        "Library/CMTEWithClassifierResultsData.hh",
        "Library/CProcessedMPTData.hh",
        "Library/CROOTData.hh",
    ],
    linkdef = "Library/LinkDef/CicadaLinkDef.hh",
    deps = [":cicada_headers"],
)

# The compiled code. cc_shared_library's deps attribute whole-archives everything listed here
# into the shared library unconditionally. Not depended on directly outside this package --
# only :cicada_headers (for headers) and :cicada (for the runtime link) are.
#
# CicadaDict_cxx is compiled in directly because TCling::RegisterModule (in libCore.so) calls
# dlopen() on whatever file holds a dictionary's compiled code -- a statically linked
# dictionary inside a PIE executable is never a valid dlopen() target (glibc >= 2.29 refuses
# it outright; other toolchains leave registration silently incomplete). A real, standalone
# .so is a valid target.
cc_library(
    name = "cicada_lib",
    srcs = [
        "Library/CClassifierResultsData.cc",
        "Library/CMTEWithClassifierResultsData.cc",
        "Library/CProcessedMPTData.cc",
        "Library/CROOTData.cc",
        ":CicadaDict_cxx",
    ],
    # ROOT's class loader looks for the generated .pcm file next to the compiled library at
    # runtime, not just compile time, so it must be a runtime dependency.
    data = [":CicadaDict_pcm"],
    deps = [":cicada_headers"],
)

# A real, standalone .so, matching the CMake build's libCicada_Katydid.so. Keeps the name
# cicada so existing consumers' deps entries for headers (@cicada//:cicada_headers) are
# unaffected. No dynamic_deps: per readelf -d, libCicada_Katydid.so needs no other
# Katydid-native or Scarab .so at runtime (see the top comment).
cc_shared_library(
    name = "cicada",
    shared_lib_name = "libCicada_Katydid.so",
    deps = [":cicada_lib"],
)
