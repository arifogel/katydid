load("@katydid//tools:root_dictionary.bzl", "root_dictionary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

# BUILD file for @cicada (github.com/Helium6CRES/cicada), Katydid's classifier-results data
# format library.
#
# Cicada supports two build configurations, controlled by whether classes live under a
# "KT"-prefixed namespace; Katydid's configuration uses the non-namespaced variant, so the
# KTROOTData/CicadaKTDict half of Cicada's own build is not built here. Cicada's optional Python
# bindings are not built either - Katydid does not use them.
#
# Cicada does not depend on Nymph - only on Scarab (for logging and reflection utilities) and
# ROOT. Confirmed directly against the CMake reference build's own readelf -d output:
# libCicada_Katydid.so's own NEEDED list contains ROOT and system libraries only, no Scarab --
# everything Cicada's own headers use from Scarab resolves entirely at compile time (inline/
# template code), so the actual link never needs libscarab.so at runtime, even though Cicada's
# own headers still need Scarab's own headers to compile at all.

package(default_visibility = ["//visibility:public"])

# Referenced directly by label from //Source/Executables/Main, to copy this header alongside
# the Katydid/Truncate binaries for Cling's runtime autoloader (see the comment there).
exports_files(["Library/_CROOTData.hh"])

# Headers plus everything a consumer's own compilation needs to see (includes, defines) -- the
# only target anything outside this package actually depends on for compile-time visibility.
# cc_shared_library itself has no defines/includes/hdrs attribute at all, so these have to
# live here, not on cicada_lib below.
#
# deps on @scarab//:scarab_headers, not @scarab itself: cc_shared_library provides no CcInfo
# at all, so a plain cc_library (this one) can never depend on one directly -- only another
# cc_shared_library can, via dynamic_deps, and only for the runtime link, not headers. (Cicada
# needs Scarab's own headers regardless of whether the eventual .so needs libscarab.so at
# runtime -- see the top comment.)
cc_library(
    name = "cicada_headers",
    hdrs = glob(["Library/*.hh"]) + [
        # CROOTData.cc includes _CROOTData.cc directly, an older C++ idiom for splitting a
        # class's implementation across multiple files without compiling each one separately.
        # It needs to be visible to the compiler like a header, even though it is a .cc file.
        "Library/_CROOTData.cc",
    ],
    defines = ["USE_CPP11"],
    includes = ["Library"],
    deps = [
        "@scarab//:scarab_headers",
        "@system_libs//:root",
    ],
)

root_dictionary(
    name = "CicadaDict",
    headers = [
        "Library/_CROOTData.hh",
        "Library/CClassifierResultsData.hh",
        "Library/CMemberVariables.hh",
        "Library/CMTEWithClassifierResultsData.hh",
        "Library/CProcessedMPTData.hh",
        "Library/CROOTData.hh",
    ],
    linkdef = "Library/LinkDef/CicadaLinkDef.hh",
    deps = [":cicada_headers"],
)

# The actual compiled code. cc_shared_library's own deps attribute whole-archives everything
# listed here into the shared library unconditionally. Not depended on directly by anything
# outside this package -- only :cicada_headers (for headers) and :cicada (for the runtime
# link) are.
#
# CicadaDict_cxx compiled in directly: TCling::RegisterModule (in libCore.so) calls dlopen()
# on whatever file contains a dictionary's compiled code -- a statically linked dictionary
# inside a PIE executable is never a valid dlopen() target (glibc >= 2.29 refuses it outright;
# other toolchains leave registration silently incomplete). This .so is a valid target on its
# own once it's real and standalone.
cc_library(
    name = "cicada_lib",
    srcs = [
        "Library/CClassifierResultsData.cc",
        "Library/CMTEWithClassifierResultsData.cc",
        "Library/CProcessedMPTData.cc",
        "Library/CROOTData.cc",
        ":CicadaDict_cxx",
    ],
    # ROOT's class loader looks for the generated .pcm file next to the compiled library at
    # runtime, not just at compile time, so it needs to be a runtime dependency.
    data = [":CicadaDict_pcm"],
    deps = [":cicada_headers"],
)

# A real, standalone .so, matching the CMake build's own libCicada_Katydid.so. Keeps the name
# cicada: every existing consumer's own deps entry for headers is unaffected (still
# @cicada//:cicada_headers). No dynamic_deps: confirmed directly against the CMake build's own
# readelf -d output that libCicada_Katydid.so needs no other Katydid-native or Scarab .so at
# runtime (see the top comment).
cc_shared_library(
    name = "cicada",
    shared_lib_name = "libCicada_Katydid.so",
    deps = [":cicada_lib"],
)
