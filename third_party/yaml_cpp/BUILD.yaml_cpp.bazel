load("@rules_cc//cc:cc_library.bzl", "cc_library")

# BUILD file for @yaml_cpp (github.com/jbeder/yaml-cpp), used by Scarab to read Katydid's YAML
# configuration files.

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "yaml_cpp",
    srcs = glob([
        "src/*.cpp",
        "src/contrib/*.cpp",
        "src/*.h",
        "src/contrib/*.h",
    ]),
    hdrs = glob(["include/yaml-cpp/**/*.h"]),
    includes = ["include"],
)
