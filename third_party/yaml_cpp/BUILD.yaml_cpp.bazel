load("@katydid//tools:katydid_cc.bzl", "katydid_cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

# BUILD file for @yaml_cpp (github.com/jbeder/yaml-cpp), used by Scarab to read Katydid's YAML
# configuration files.

package(default_visibility = ["//visibility:public"])

katydid_cc_library(
    name = "yaml_cpp_headers",
    hdrs = glob(["include/yaml-cpp/**/*.h"]),
    includes = ["include"],
)

# Compiled from source, since yaml-cpp isn't provided as a system package here.
katydid_cc_library(
    name = "yaml_cpp_lib",
    srcs = glob([
        "src/*.cpp",
        "src/contrib/*.cpp",
        "src/*.h",
        "src/contrib/*.h",
    ]),
    deps = [":yaml_cpp_headers"],
)

cc_shared_library(
    name = "yaml_cpp",
    shared_lib_name = "libyaml-cpp.so",
    deps = [":yaml_cpp_lib"],
)
