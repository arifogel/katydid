load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

# BUILD file for @yaml_cpp (github.com/jbeder/yaml-cpp), used by Scarab to read Katydid's YAML
# configuration files.

package(default_visibility = ["//visibility:public"])

# Headers plus everything a consumer's own compilation needs to see - the only target anything
# outside this package actually depends on for compile-time visibility. cc_shared_library
# itself has no hdrs/includes attribute at all, so these have to live here, not on
# yaml_cpp_lib below.
cc_library(
    name = "yaml_cpp_headers",
    hdrs = glob(["include/yaml-cpp/**/*.h"]),
    includes = ["include"],
)

# The actual compiled code: real, substantial source we compile ourselves (unlike
# boost/fftw/matio/root, which already exist as precompiled system .so's and are wrapped via
# cc_import instead - see tools/system_deps.bzl's own top comment). cc_shared_library's own
# deps attribute whole-archives everything listed here into the shared library
# unconditionally. Not depended on directly by anything outside this package - only
# :yaml_cpp_headers (for headers) and :yaml_cpp (for the runtime link) are.
cc_library(
    name = "yaml_cpp_lib",
    srcs = glob([
        "src/*.cpp",
        "src/contrib/*.cpp",
        "src/*.h",
        "src/contrib/*.h",
    ]),
    deps = [":yaml_cpp_headers"],
)

# A real, standalone .so, matching the CMake reference build's own libyaml-cpp.so.0.5
# (confirmed directly against its own readelf -d output: a single, standalone .so, never
# statically linked into anything else). Keeps the name yaml_cpp: every existing consumer's
# own deps entry for headers is unaffected (still @yaml_cpp//:yaml_cpp_headers); scarab's own
# dynamic_deps carries the genuine runtime dependency on this .so directly.
cc_shared_library(
    name = "yaml_cpp",
    shared_lib_name = "libyaml-cpp.so",
    deps = [":yaml_cpp_lib"],
)
