# BUILD file for the vendored copy of RapidXML (a header-only XML parsing library), used by
# Katydid's IO module to read digitizer configuration files.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "rapidxml",
    hdrs = glob(["*.hpp"]),
    includes = ["."],
)
