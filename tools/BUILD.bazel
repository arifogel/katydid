# A --define flag distinguishes AlmaLinux from Ubuntu/macOS at build time: @platforms only
# models OS/CPU, not Linux distro, and this needs to be a build-time choice a select() can see,
# not a repository-rule-time host check. Set via --config=almalinux (see .bazelrc);
# Source/Utility/BUILD.bazel's Boost/FFTW select() uses this to choose between
# tools/rpm_deps.bzl's hermetic fetch (AlmaLinux) and tools/system_deps.bzl's host discovery
# (everywhere else).
config_setting(
    name = "is_almalinux",
    values = {"define": "distro=almalinux"},
)
