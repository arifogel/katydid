# Builds Katydid's Utility module: general-purpose helper classes used throughout Katydid
# (physical arrays, axis handling, random number generation, and the ROOT-integrated
# application/GUI loop), plus the ROOT dictionary for the one class here (KTRootGuiLoop) that
# needs to be usable interactively from the ROOT prompt.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//tools:root_dictionary.bzl", "root_dictionary")

package(default_visibility = ["//visibility:public"])

# Headers and consumer-visible compile flags (includes, defines) -- the only target anything
# outside this package depends on for compile-time visibility. cc_shared_library has no
# defines/includes/hdrs attribute, so these must live here, not on katydid_utility_lib below.
#
# Depends on @nymph//:nymph_headers/@scarab//:scarab_headers, not @nymph/@scarab themselves:
# cc_shared_library produces no CcInfo, so a plain cc_library can only reach another via
# dynamic_deps, for the runtime link, never directly for headers.
cc_library(
    name = "katydid_utility_headers",
    hdrs = glob([
        "*.hh",
        "complexpolar/*.hh",
    ]),
    defines = ["USE_CPP11"],
    includes = ["."],
    deps = [
        "@nymph//:nymph_headers",
        "@root",
        "@scarab//:scarab_headers",
        "@system_libs//:boost",
        "@system_libs//:fftw",
    ],
)

root_dictionary(
    name = "UtilityDict",
    headers = ["KTRootGuiLoop.hh"],
    linkdef = "LinkDef/UtilityLinkDef.hh",
    deps = [":katydid_utility_headers"],
)

# The compiled code. cc_shared_library's deps attribute whole-archives everything here into the
# shared library unconditionally. Nothing outside this package depends on this directly --
# only :katydid_utility_headers (headers) and :katydid_utility (runtime link) do.
#
# UtilityDict_cxx is compiled in directly: TCling::RegisterModule (in libCore.so) calls
# dlopen() on whatever file holds a dictionary's compiled code, and a statically linked
# dictionary inside a PIE executable is never a valid dlopen() target (glibc >= 2.29 refuses
# it outright; other toolchains leave registration silently incomplete).
cc_library(
    name = "katydid_utility_lib",
    srcs = [
        "KTAxisProperties.cc",
        "KTCountHistogram.cc",
        "KTECDF.cc",
        "KTKatydidApp.cc",
        "KTRandom.cc",
        "KTRootGuiLoop.cc",
        "KTSmooth.cc",
        "KTSpline.cc",
        "complexpolar/specialization.cc",
        ":UtilityDict_cxx",
    ],
    # ROOT's class loader looks for the generated .pcm file next to the compiled library at
    # runtime, not just at compile time, so it needs to be a runtime dependency.
    data = [":UtilityDict_pcm"],
    deps = [":katydid_utility_headers"],
)

# A real, standalone .so, matching the CMake build's libKatydidUtility.so. Keeps the name
# katydid_utility so existing consumers' headers deps
# (//Source/Utility:katydid_utility_headers) stay valid; dynamic_deps carries the runtime
# dependency on libnymph.so/libscarab.so.
cc_shared_library(
    name = "katydid_utility",
    dynamic_deps = [
        "@nymph",
        "@scarab",
    ],
    shared_lib_name = "libKatydidUtility.so",
    deps = [":katydid_utility_lib"],
)
