# Builds Katydid's Utility module: general-purpose helper classes used throughout Katydid
# (physical arrays, axis handling, random number generation, and the ROOT-integrated
# application/GUI loop), plus the ROOT dictionary for the one class here (KTRootGuiLoop) that
# needs to be usable interactively from the ROOT prompt.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//tools:root_dictionary.bzl", "root_dictionary")

package(default_visibility = ["//visibility:public"])

# Headers plus everything a consumer's own compilation needs to see (includes, defines) -- the
# only target anything outside this package actually depends on for compile-time visibility.
# cc_shared_library itself has no defines/includes/hdrs attribute at all, so these have to
# live here, not on katydid_utility_lib below.
#
# deps on @nymph//:nymph_headers/@scarab//:scarab_headers, not @nymph/@scarab themselves:
# cc_shared_library provides no CcInfo at all, so a plain cc_library (this one) can never
# depend on one directly -- only another cc_shared_library can, via dynamic_deps, and only
# for the runtime link, not headers.
cc_library(
    name = "katydid_utility_headers",
    hdrs = glob([
        "*.hh",
        "complexpolar/*.hh",
    ]),
    defines = ["USE_CPP11"],
    includes = ["."],
    deps = [
        "@nymph//:nymph_headers",
        "@root",
        "@scarab//:scarab_headers",
        "@system_libs//:boost",
        "@system_libs//:fftw",
    ],
)

root_dictionary(
    name = "UtilityDict",
    headers = ["KTRootGuiLoop.hh"],
    linkdef = "LinkDef/UtilityLinkDef.hh",
    deps = [":katydid_utility_headers"],
)

# The actual compiled code. cc_shared_library's own deps attribute whole-archives everything
# listed here into the shared library unconditionally. Not depended on directly by anything
# outside this package -- only :katydid_utility_headers (for headers) and :katydid_utility
# (for the runtime link) are.
#
# UtilityDict_cxx compiled in directly: TCling::RegisterModule (in libCore.so) calls dlopen()
# on whatever file contains a dictionary's compiled code -- a statically linked dictionary
# inside a PIE executable is never a valid dlopen() target (glibc >= 2.29 refuses it outright;
# other toolchains leave registration silently incomplete). This .so is a valid target on its
# own once it's real and standalone.
cc_library(
    name = "katydid_utility_lib",
    srcs = [
        "KTAxisProperties.cc",
        "KTCountHistogram.cc",
        "KTECDF.cc",
        "KTKatydidApp.cc",
        "KTRandom.cc",
        "KTRootGuiLoop.cc",
        "KTSmooth.cc",
        "KTSpline.cc",
        "complexpolar/specialization.cc",
        ":UtilityDict_cxx",
    ],
    # ROOT's class loader looks for the generated .pcm file next to the compiled library at
    # runtime, not just at compile time, so it needs to be a runtime dependency.
    data = [":UtilityDict_pcm"],
    deps = [":katydid_utility_headers"],
)

# A real, standalone .so, matching the CMake build's own libKatydidUtility.so. Keeps the name
# katydid_utility: every existing consumer's own deps entry for headers is unaffected (still
# //Source/Utility:katydid_utility_headers); dynamic_deps carries the genuine runtime
# dependency on libnymph.so/libscarab.so.
cc_shared_library(
    name = "katydid_utility",
    dynamic_deps = [
        "@nymph",
        "@scarab",
    ],
    shared_lib_name = "libKatydidUtility.so",
    deps = [":katydid_utility_lib"],
)
