# Builds Katydid's Utility module: general-purpose helper classes used throughout Katydid
# (physical arrays, axis handling, random number generation, and the ROOT-integrated
# application/GUI loop), plus the ROOT dictionary for the one class here (KTRootGuiLoop) that
# needs to be usable interactively from the ROOT prompt.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tools:root_dictionary.bzl", "root_dictionary")

package(default_visibility = ["//visibility:public"])

# Exposes this module's headers, and everything reachable through its dependencies, without
# depending on the full katydid_utility library below - which would be circular, since that
# library's sources include the dictionary file generated from this target.
cc_library(
    name = "katydid_utility_headers",
    hdrs = glob([
        "*.hh",
        "complexpolar/*.hh",
    ]),
    includes = ["."],
    deps = [
        "@nymph",
        "@scarab",
        "@system_libs//:boost",
        "@system_libs//:fftw",
        "@system_libs//:root",
    ],
)

root_dictionary(
    name = "UtilityDict",
    headers = ["KTRootGuiLoop.hh"],
    linkdef = "LinkDef/UtilityLinkDef.hh",
    deps = [":katydid_utility_headers"],
)

# A real, standalone .so, matching the CMake build's own libKatydidUtility.so: a statically
# linked dictionary inside a PIE executable is never a valid dlopen() target for
# TCling::RegisterModule (see //Source/Executables/Main's own comment on
# libroot_dict_shared.so for the full explanation). UtilityDict_cxx was compiled statically
# into this module before this change, same bug as IODict/CicadaDict had before their own fix.
cc_binary(
    name = "libKatydidUtility.so",
    srcs = [
        "KTAxisProperties.cc",
        "KTCountHistogram.cc",
        "KTECDF.cc",
        "KTKatydidApp.cc",
        "KTRandom.cc",
        "KTRootGuiLoop.cc",
        "KTSmooth.cc",
        "KTSpline.cc",
        "complexpolar/specialization.cc",
        ":UtilityDict_cxx",
    ],
    # ROOT's class loader looks for the generated .pcm file next to the compiled library at
    # runtime, not just at compile time, so it needs to be a runtime dependency.
    data = [":UtilityDict_pcm"],
    defines = ["USE_CPP11"],
    linkshared = True,
    deps = [
        ":katydid_utility_headers",
        "@nymph",
        "@scarab",
        "@system_libs//:boost",
        "@system_libs//:fftw",
        "@system_libs//:root",
    ],
)

# Wraps the .so above so consumers link against it as a genuine runtime dependency (a real
# DT_NEEDED entry), the same way //Source/Executables/Main:root_dict_import wraps
# libroot_dict_shared.so. Keeps the name katydid_utility: every existing consumer's own deps
# entry needs no change.
#
# deps also lists @nymph/@scarab directly, not just headers: libKatydidUtility.so genuinely
# needs libnymph.so/libscarab.so at runtime, but cc_import doesn't see through the .so it
# wraps to discover that on its own -- a consumer of :katydid_utility that doesn't also
# depend on @nymph/@scarab directly needs this told explicitly.
cc_import(
    name = "katydid_utility",
    shared_library = ":libKatydidUtility.so",
    deps = [
        ":katydid_utility_headers",
        "@nymph",
        "@scarab",
    ],
)
