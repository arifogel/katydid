# Builds Katydid's SpectrumAnalysis module: processors that operate on frequency spectra and
# spectrograms (gain normalization and variation correction, noise/point discrimination,
# clustering, track-finding, and related analyses).
#
# Excluded here: KTBiasedACM and KTRQProcessor, which depend on the Eigen linear algebra
# library, not part of Katydid's default configuration.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

package(default_visibility = ["//Source:__subpackages__"])

cc_library(
    name = "katydid_spectrum_analysis_headers",
    hdrs = glob(["*.hh"]),
    includes = ["."],
    deps = [
        "//Source/Data:katydid_data_headers",
        "//Source/IO:katydid_io_headers",
        "//Source/Transform:katydid_transform_headers",
        "//Source/Utility:katydid_utility_headers",
    ],
)

cc_library(
    name = "katydid_spectrum_analysis_lib",
    srcs = [
        "KTAggregatedChannelOptimizer.cc",
        "KTAmplitudeCounter.cc",
        "KTAmplitudeDistributor.cc",
        "KTAnalyticAssociator.cc",
        "KTChannelAggregator.cc",
        "KTConsensusThresholding.cc",
        "KTConvolution.cc",
        "KTCorrelator.cc",
        "KTCreateKDTree.cc",
        "KTDBSCANNoiseFiltering.cc",
        "KTDataAccumulator.cc",
        "KTDistanceClustering.cc",
        "KTGainNormalization.cc",
        "KTGainVariationDiffProcessor.cc",
        "KTGainVariationProcessor.cc",
        "KTHoughTransform.cc",
        "KTLongTrackFinder.cc",
        "KTMergeKDTree.cc",
        "KTNNFilter.cc",
        "KTSequentialTrackFinder.cc",
        "KTSpectrogramStriper.cc",
        "KTSpectrumDiscriminator.cc",
        "KTSwitchFFTWPolar.cc",
        "KTVariableSpectrumDiscriminator.cc",
        "KTWignerVille.cc",
    ],
    deps = [":katydid_spectrum_analysis_headers"],
)

cc_shared_library(
    name = "katydid_spectrum_analysis",
    dynamic_deps = [
        "//Source/Data:katydid_data",
        "//Source/IO:katydid_io",
        "//Source/Transform:katydid_transform",
        "//Source/Utility:katydid_utility",
        "@nymph",
        "@scarab",
    ],
    shared_lib_name = "libKatydidSpectrumAnalysis.so",
    deps = [":katydid_spectrum_analysis_lib"],
)
