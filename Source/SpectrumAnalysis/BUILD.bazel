# Builds Katydid's SpectrumAnalysis module: processors that operate on frequency spectra and
# spectrograms (gain normalization and variation correction, noise/point discrimination,
# clustering, track-finding, and related analyses).
#
# Excluded here: KTBiasedACM and KTRQProcessor, which depend on the Eigen linear algebra
# library, not part of Katydid's default configuration.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

# Headers and consumer-visible compile flags (includes) -- the only target anything outside
# this package depends on for compile-time visibility. cc_shared_library has no
# defines/includes/hdrs attribute, so these must live here, not on
# katydid_spectrum_analysis_lib below.
#
# Depends on other modules' own _headers targets, not the modules themselves: cc_shared_library
# produces no CcInfo, so a plain cc_library can only reach another via dynamic_deps, for the
# runtime link, never directly for headers.
cc_library(
    name = "katydid_spectrum_analysis_headers",
    hdrs = glob(["*.hh"]),
    includes = ["."],
    deps = [
        "//Source/Data:katydid_data_headers",
        "//Source/IO:katydid_io_headers",
        "//Source/Transform:katydid_transform_headers",
        "//Source/Utility:katydid_utility_headers",
    ],
)

# The compiled code. cc_shared_library's deps attribute whole-archives everything here into the
# shared library unconditionally, giving KT_REGISTER_PROCESSOR/READER/WRITER/EGGREADER's
# static-initializer registration the same guarantee alwayslink = 1 gave under static linking.
# Nothing outside this package depends on this directly -- only
# :katydid_spectrum_analysis_headers (headers) and :katydid_spectrum_analysis (runtime link) do.
cc_library(
    name = "katydid_spectrum_analysis_lib",
    srcs = [
        "KTAggregatedChannelOptimizer.cc",
        "KTAmplitudeCounter.cc",
        "KTAmplitudeDistributor.cc",
        "KTAnalyticAssociator.cc",
        "KTChannelAggregator.cc",
        "KTConsensusThresholding.cc",
        "KTConvolution.cc",
        "KTCorrelator.cc",
        "KTCreateKDTree.cc",
        "KTDBSCANNoiseFiltering.cc",
        "KTDataAccumulator.cc",
        "KTDistanceClustering.cc",
        "KTGainNormalization.cc",
        "KTGainVariationDiffProcessor.cc",
        "KTGainVariationProcessor.cc",
        "KTHoughTransform.cc",
        "KTLongTrackFinder.cc",
        "KTMergeKDTree.cc",
        "KTNNFilter.cc",
        "KTSequentialTrackFinder.cc",
        "KTSpectrogramStriper.cc",
        "KTSpectrumDiscriminator.cc",
        "KTSwitchFFTWPolar.cc",
        "KTVariableSpectrumDiscriminator.cc",
        "KTWignerVille.cc",
    ],
    deps = [":katydid_spectrum_analysis_headers"],
)

# A real, standalone .so, matching the CMake build's libKatydidSpectrumAnalysis.so. Keeps the
# name katydid_spectrum_analysis so existing consumers' headers deps
# (//Source/SpectrumAnalysis:katydid_spectrum_analysis_headers) stay valid; dynamic_deps
# carries the runtime dependency on
# libKatydidData.so/libKatydidIO.so/libKatydidTransform.so/libKatydidUtility.so.
cc_shared_library(
    name = "katydid_spectrum_analysis",
    dynamic_deps = [
        "//Source/Data:katydid_data",
        "//Source/IO:katydid_io",
        "//Source/Transform:katydid_transform",
        "//Source/Utility:katydid_utility",
        "@nymph",
        "@scarab",
    ],
    shared_lib_name = "libKatydidSpectrumAnalysis.so",
    deps = [":katydid_spectrum_analysis_lib"],
)
