# Builds Katydid's SpectrumAnalysis module: processors that operate on frequency spectra and
# spectrograms (gain normalization and variation correction, noise/point discrimination,
# clustering, track-finding, and related analyses).
#
# Excluded here: KTBiasedACM and KTRQProcessor, which depend on the Eigen linear algebra
# library, not part of Katydid's default configuration.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

# Headers plus everything a consumer's own compilation needs to see (includes) -- the only
# target anything outside this package actually depends on for compile-time visibility.
# cc_shared_library itself has no defines/includes/hdrs attribute at all, so these have to
# live here, not on katydid_spectrum_analysis_lib below.
#
# deps on other modules' own _headers targets, not the modules themselves: cc_shared_library
# provides no CcInfo at all, so a plain cc_library (this one) can never depend on one
# directly -- only another cc_shared_library can, via dynamic_deps, and only for the runtime
# link, not headers.
cc_library(
    name = "katydid_spectrum_analysis_headers",
    hdrs = glob(["*.hh"]),
    includes = ["."],
    deps = [
        "//Source/Data:katydid_data_headers",
        "//Source/IO:katydid_io_headers",
        "//Source/Transform:katydid_transform_headers",
        "//Source/Utility:katydid_utility_headers",
    ],
)

# The actual compiled code. cc_shared_library's own deps attribute whole-archives everything
# listed here into the shared library unconditionally, so KT_REGISTER_PROCESSOR/READER/
# WRITER/EGGREADER's own static-initializer registration is guaranteed to run, the same
# guarantee alwayslink = 1 gave on a cc_library consumed by static linking. Not depended on
# directly by anything outside this package -- only :katydid_spectrum_analysis_headers (for
# headers) and :katydid_spectrum_analysis (for the runtime link) are.
cc_library(
    name = "katydid_spectrum_analysis_lib",
    srcs = [
        "KTAggregatedChannelOptimizer.cc",
        "KTAmplitudeCounter.cc",
        "KTAmplitudeDistributor.cc",
        "KTAnalyticAssociator.cc",
        "KTChannelAggregator.cc",
        "KTConsensusThresholding.cc",
        "KTConvolution.cc",
        "KTCorrelator.cc",
        "KTCreateKDTree.cc",
        "KTDBSCANNoiseFiltering.cc",
        "KTDataAccumulator.cc",
        "KTDistanceClustering.cc",
        "KTGainNormalization.cc",
        "KTGainVariationDiffProcessor.cc",
        "KTGainVariationProcessor.cc",
        "KTHoughTransform.cc",
        "KTLongTrackFinder.cc",
        "KTMergeKDTree.cc",
        "KTNNFilter.cc",
        "KTSequentialTrackFinder.cc",
        "KTSpectrogramStriper.cc",
        "KTSpectrumDiscriminator.cc",
        "KTSwitchFFTWPolar.cc",
        "KTVariableSpectrumDiscriminator.cc",
        "KTWignerVille.cc",
    ],
    deps = [":katydid_spectrum_analysis_headers"],
)

# A real, standalone .so, matching the CMake build's own libKatydidSpectrumAnalysis.so. Keeps
# the name katydid_spectrum_analysis: every existing consumer's own deps entry for headers is
# unaffected (still //Source/SpectrumAnalysis:katydid_spectrum_analysis_headers);
# dynamic_deps carries the genuine runtime dependency on libKatydidData.so/libKatydidIO.so/
# libKatydidTransform.so/libKatydidUtility.so.
cc_shared_library(
    name = "katydid_spectrum_analysis",
    dynamic_deps = [
        "//Source/Data:katydid_data",
        "//Source/IO:katydid_io",
        "//Source/Transform:katydid_transform",
        "//Source/Utility:katydid_utility",
        "@nymph",
        "@scarab",
    ],
    shared_lib_name = "libKatydidSpectrumAnalysis.so",
    deps = [":katydid_spectrum_analysis_lib"],
)
