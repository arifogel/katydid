# Builds Katydid's EventAnalysis module: processors that identify and classify particle tracks
# and events from spectrogram data (clustering, cut classes, track/event builders, and
# classifiers), plus the ROOT-based TMVA and linear density fitting processors.
#
# KTDLIBClassifier.cc/.hh is excluded here: it depends on the DLIB machine-learning library,
# which is not part of Katydid's default configuration.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "katydid_event_analysis_headers",
    hdrs = glob([
        "*.hh",
        "CutClasses/*.hh",
    ]),
    includes = [
        ".",
        "CutClasses",
    ],
    deps = [
        "//Source/Data:katydid_data_headers",
        "//Source/IO:katydid_io_headers",
        "//Source/Utility:katydid_utility_headers",
    ],
)

cc_library(
    name = "katydid_event_analysis_lib",
    srcs = [
        "CutClasses/KTEventFirstTrackNPointsCut.cc",
        "CutClasses/KTEventFirstTrackNUPCut.cc",
        "CutClasses/KTEventFirstTrackPowerCut.cc",
        "CutClasses/KTEventFirstTrackSNRCut.cc",
        "CutClasses/KTEventTimeCut.cc",
        "CutClasses/KTEventTimeInAcqCut.cc",
        "CutClasses/KTLinearFitCut.cc",
        "CutClasses/KTMultiPeakTrackEventSequenceIDCut.cc",
        "CutClasses/KTMultiPeakTrackMultiplicityCut.cc",
        "CutClasses/KTNTracksNPointsNUPCut.cc",
        "CutClasses/KTPowerFitCut.cc",
        "CutClasses/KTProcessedTrackCut.cc",
        "CutClasses/KTSequentialLineNUPCut.cc",
        "CutClasses/KTSequentialLinePointDensityCut.cc",
        "CutClasses/KTSequentialLineSNRCut.cc",
        "CutClasses/KTTrackFreqCut.cc",
        "CutClasses/KTTrackMVACut.cc",
        "CutClasses/KTTrackMainbandCut.cc",
        "CutClasses/KTTrackTimeCut.cc",
        "KTCollinearTrackClustering.cc",
        "KTDBSCANEventClustering.cc",
        "KTDBSCANEventSIDClustering.cc",
        "KTDBSCANLongTrackCollinearClustering.cc",
        "KTDBSCANTrackClustering.cc",
        "KTDataCutter.cc",
        "KTFrequencyCandidateIdentifier.cc",
        "KTIterativeTrackClustering.cc",
        "KTLinearDensityProbeFit.cc",
        "KTMultiBandEventBuilder.cc",
        "KTMultiPeakEventBuilder.cc",
        "KTMultiPeakTrackBuilder.cc",
        "KTMultiPeakTrackProcessing.cc",
        "KTMultiSliceClustering.cc",
        "KTOverlappingTrackClustering.cc",
        "KTRPClassifier.cc",
        "KTSidebandCorrection.cc",
        "KTSpectrogramCollector.cc",
        "KTTMVAClassifier.cc",
        "KTTrackProcessingDoubleCuts.cc",
        "KTTrackProcessingWeightedSlope.cc",
    ],
    deps = [":katydid_event_analysis_headers"],
)

# A real, standalone .so, matching the CMake build's libKatydidEventAnalysis.so. Keeps the
# name katydid_event_analysis so existing consumers' headers deps
# (//Source/EventAnalysis:katydid_event_analysis_headers) stay valid.
cc_shared_library(
    name = "katydid_event_analysis",
    dynamic_deps = [
        "//Source/Data:katydid_data",
        "//Source/IO:katydid_io",
        "//Source/Utility:katydid_utility",
        "@nymph",
        "@scarab",
    ],
    shared_lib_name = "libKatydidEventAnalysis.so",
    deps = [":katydid_event_analysis_lib"],
)
