# Builds Katydid's Data module: the plain data-container classes (spectra, time series, tracks,
# events, and related types) that Katydid's processors read and write, as distinct from the
# processors that operate on them.
#
# The "." entry in `includes` lets consumers outside this package use paths like
# `#include "SpectrumAnalysis/KTAmplitudeDistribution.hh"`; the per-subdirectory entries are
# needed because some files in this module include their own siblings with angle brackets
# (e.g. `#include <KTLongTrackData.hh>`) rather than quotes, and angle-bracket includes are not
# automatically resolved relative to the including file's own directory the way quoted includes
# are.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

# Headers and consumer-visible compile flags (includes) -- the only target anything outside
# this package depends on for compile-time visibility. cc_shared_library has no
# defines/includes/hdrs attribute, so these must live here, not on katydid_data_lib below.
#
# Depends on //Source/Utility:katydid_utility_headers, not katydid_utility: cc_shared_library
# produces no CcInfo, so a plain cc_library can only reach another via dynamic_deps, for the
# runtime link, never directly for headers.
cc_library(
    name = "katydid_data_headers",
    hdrs = glob([
        "SpectrumAnalysis/*.hh",
        "EventAnalysis/*.hh",
        "Time/*.hh",
        "Transform/*.hh",
    ]),
    includes = [
        ".",
        "EventAnalysis",
        "SpectrumAnalysis",
        "Time",
        "Transform",
    ],
    deps = [
        "//Source/Utility:katydid_utility_headers",
        "//vendor/nanoflann",
    ],
)

# The compiled code. cc_shared_library's deps attribute whole-archives everything here into the
# shared library unconditionally. Nothing outside this package depends on this directly --
# only :katydid_data_headers (headers) and :katydid_data (runtime link) do.
cc_library(
    name = "katydid_data_lib",
    srcs = [
        "EventAnalysis/KTClassifierResultsData.cc",
        "EventAnalysis/KTFrequencyCandidate.cc",
        "EventAnalysis/KTFrequencyCandidateData.cc",
        "EventAnalysis/KTLinearFitResult.cc",
        "EventAnalysis/KTLongTrackData.cc",
        "EventAnalysis/KTMultiBandEventData.cc",
        "EventAnalysis/KTMultiTrackEventData.cc",
        "EventAnalysis/KTPowerFitData.cc",
        "EventAnalysis/KTProcessedMPTData.cc",
        "EventAnalysis/KTProcessedTrackData.cc",
        "EventAnalysis/KTRPTrackData.cc",
        "EventAnalysis/KTSequentialLineData.cc",
        "EventAnalysis/KTSparseWaterfallCandidateData.cc",
        "EventAnalysis/KTSpectrumCollectionData.cc",
        "EventAnalysis/KTWaterfallCandidateData.cc",
        "SpectrumAnalysis/KTAmplitudeDistribution.cc",
        "SpectrumAnalysis/KTAnalyticAssociateData.cc",
        "SpectrumAnalysis/KTChannelAggregatedData.cc",
        "SpectrumAnalysis/KTCluster1DData.cc",
        "SpectrumAnalysis/KTCorrelationData.cc",
        "SpectrumAnalysis/KTCorrelationTSData.cc",
        "SpectrumAnalysis/KTDiscriminatedPoints1DData.cc",
        "SpectrumAnalysis/KTDiscriminatedPoints2DData.cc",
        "SpectrumAnalysis/KTGainVarChi2Data.cc",
        "SpectrumAnalysis/KTGainVariationData.cc",
        "SpectrumAnalysis/KTHoughData.cc",
        "SpectrumAnalysis/KTKDTreeData.cc",
        "SpectrumAnalysis/KTNormalizedFSData.cc",
        "SpectrumAnalysis/KTTimeSeriesDist.cc",
        "SpectrumAnalysis/KTTimeSeriesDistData.cc",
        "SpectrumAnalysis/KTWV2DData.cc",
        "SpectrumAnalysis/KTWignerVilleData.cc",
        "Time/KTDigitizerTestData.cc",
        "Time/KTEggHeader.cc",
        "Time/KTPhysicalArrayFFTW.cc",
        "Time/KTProcSummary.cc",
        "Time/KTRawTimeSeries.cc",
        "Time/KTRawTimeSeriesData.cc",
        "Time/KTSliceHeader.cc",
        "Time/KTTimeSeries.cc",
        "Time/KTTimeSeriesData.cc",
        "Time/KTTimeSeriesFFTW.cc",
        "Time/KTTimeSeriesReal.cc",
        "Transform/KTConvolvedSpectrumData.cc",
        "Transform/KTFrequencyDomainArray.cc",
        "Transform/KTFrequencySpectrum.cc",
        "Transform/KTFrequencySpectrumDataFFTW.cc",
        "Transform/KTFrequencySpectrumDataPolar.cc",
        "Transform/KTFrequencySpectrumFFTW.cc",
        "Transform/KTFrequencySpectrumPolar.cc",
        "Transform/KTFrequencySpectrumVariance.cc",
        "Transform/KTFrequencySpectrumVarianceData.cc",
        "Transform/KTMultiFSDataFFTW.cc",
        "Transform/KTMultiFSDataPolar.cc",
        "Transform/KTMultiPSData.cc",
        "Transform/KTPowerSpectrum.cc",
        "Transform/KTPowerSpectrumData.cc",
        "Transform/KTPowerSpectrumUncertaintyData.cc",
        "Transform/KTTimeFrequency.cc",
        "Transform/KTTimeFrequencyDataPolar.cc",
        "Transform/KTTimeFrequencyPolar.cc",
    ],
    deps = [":katydid_data_headers"],
)

# A real, standalone .so, matching the CMake build's libKatydidData.so. Keeps the name
# katydid_data so existing consumers' headers deps (//Source/Data:katydid_data_headers) stay
# valid; dynamic_deps carries the runtime dependency on libKatydidUtility.so/libnymph.so.
cc_shared_library(
    name = "katydid_data",
    dynamic_deps = [
        "//Source/Utility:katydid_utility",
        "@nymph",
    ],
    shared_lib_name = "libKatydidData.so",
    deps = [":katydid_data_lib"],
)
