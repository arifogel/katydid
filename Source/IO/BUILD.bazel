# Builds Katydid's IO module: readers and writers connecting Katydid to on-disk formats (ROOT
# files, ASCII, JSON) and interactive ROOT display windows, plus the ROOT dictionary needed to
# use a couple of these classes interactively from the ROOT prompt.
#
# Excluded from this build, matching Katydid's default configuration: HDF5-based writers and
# GraphicsMagick-based image writers (both optional features, off by default), and the Monarch
# egg-file reader (Katydid's raw-data reading library, also off by default).
#
# Each writer subdirectory is listed individually in `includes` below because Katydid's code
# refers to these headers without a subdirectory prefix (e.g. `#include "KTBasicROOTFileWriter.hh"`
# rather than `#include "BasicROOTFileWriter/KTBasicROOTFileWriter.hh"`), so each subdirectory
# needs to be directly on the compiler's search path.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//tools:root_dictionary.bzl", "root_dictionary")

package(default_visibility = ["//visibility:public"])

_IO_INCLUDES = [
    ".",
    "BasicAsciiWriter",
    "BasicROOTFileWriter",
    "Conversions",
    "DataDisplay",
    "JSONWriter",
    "MultiSliceROOTWriter",
    "OfficialCandidatesWriter",
    "ROOTSpectrogramWriter",
    "ROOTTreeWriter",
    "TerminalWriter",
]

_IO_HDRS = glob([
    "*.hh",
    "BasicAsciiWriter/*.hh",
    "BasicROOTFileWriter/*.hh",
    "Conversions/*.hh",
    "DataDisplay/*.hh",
    "JSONWriter/*.hh",
    "MultiSliceROOTWriter/*.hh",
    "OfficialCandidatesWriter/*.hh",
    "ROOTSpectrogramWriter/*.hh",
    "ROOTTreeWriter/*.hh",
    "TerminalWriter/*.hh",
])

# Headers plus everything a consumer's own compilation needs to see (includes) -- the only
# target anything outside this package actually depends on for compile-time visibility.
# cc_shared_library itself has no defines/includes/hdrs attribute at all, so these have to
# live here, not on katydid_io_lib below.
#
# deps on other modules' own _headers targets, not the modules themselves: cc_shared_library
# provides no CcInfo at all, so a plain cc_library (this one) can never depend on one
# directly -- only another cc_shared_library can, via dynamic_deps, and only for the runtime
# link, not headers.
cc_library(
    name = "katydid_io_headers",
    hdrs = _IO_HDRS,
    includes = _IO_INCLUDES,
    deps = [
        "//Source/Data:katydid_data_headers",
        "//Source/Utility:katydid_utility_headers",
        "//vendor/RapidXML:rapidxml",
        "@cicada//:cicada_headers",
    ],
)

root_dictionary(
    name = "IODict",
    headers = [
        "DataDisplay/KTDisplayWindow.hh",
        "Conversions/KTROOTData.hh",
    ],
    linkdef = "LinkDef/IOLinkDef.hh",
    deps = [":katydid_io_headers"],
)

# The actual compiled code. cc_shared_library's own deps attribute whole-archives everything
# listed here into the shared library unconditionally, so KT_REGISTER_PROCESSOR/READER/
# WRITER/EGGREADER's own static-initializer registration is guaranteed to run, the same
# guarantee alwayslink = 1 gave on a cc_library consumed by static linking. Not depended on
# directly by anything outside this package -- only :katydid_io_headers (for headers) and
# :katydid_io (for the runtime link) are.
#
# IODict_cxx compiled in directly: TCling::RegisterModule (in libCore.so) calls dlopen() on
# whatever file contains a dictionary's compiled code -- a statically linked dictionary
# inside a PIE executable is never a valid dlopen() target (glibc >= 2.29 refuses it outright;
# other toolchains leave registration silently incomplete). This .so is a valid target on its
# own once it's real and standalone -- the split into katydid_io_root_types (now removed)
# existed specifically to avoid double registration between a statically linked copy and a
# separate dictionary-only .so; a single, real .so loaded exactly once needs no such split.
cc_library(
    name = "katydid_io_lib",
    srcs = [
        "BasicAsciiWriter/KTBasicASCIITypeWriterTS.cc",
        "BasicAsciiWriter/KTBasicAsciiWriter.cc",
        "BasicROOTFileWriter/KTBasicROOTFileWriter.cc",
        "BasicROOTFileWriter/KTBasicROOTTypeWriterEventAnalysis.cc",
        "BasicROOTFileWriter/KTBasicROOTTypeWriterSpectrumAnalysis.cc",
        "BasicROOTFileWriter/KTBasicROOTTypeWriterTime.cc",
        "BasicROOTFileWriter/KTBasicROOTTypeWriterTransform.cc",
        "Conversions/KT2ROOT.cc",
        "Conversions/KTROOTData.cc",
        "DataDisplay/KTDataDisplay.cc",
        "DataDisplay/KTDataTypeDisplayEventAnalysis.cc",
        "DataDisplay/KTDataTypeDisplaySpectrumAnalysis.cc",
        "DataDisplay/KTDataTypeDisplayTime.cc",
        "DataDisplay/KTDataTypeDisplayTransform.cc",
        "DataDisplay/KTDisplayWindow.cc",
        "JSONWriter/KTJSONTypeWriterEventAnalysis.cc",
        "JSONWriter/KTJSONTypeWriterTime.cc",
        "JSONWriter/KTJSONWriter.cc",
        "KTDPTReader.cc",
        "KTLongSpecProcessor.cc",
        "KTMultiFileROOTTreeReader.cc",
        "KTRFSlewtoVec.cc",
        "KTROOTWriterFileManager.cc",
        "KTSpecProcessor.cc",
        "KTSpecReader.cc",
        "KTSpeckProcessor.cc",
        "MultiSliceROOTWriter/KTMultiSliceROOTTypeWriterSpectrumAnalysis.cc",
        "MultiSliceROOTWriter/KTMultiSliceROOTTypeWriterTime.cc",
        "MultiSliceROOTWriter/KTMultiSliceROOTTypeWriterTransform.cc",
        "MultiSliceROOTWriter/KTMultiSliceROOTWriter.cc",
        "OfficialCandidatesWriter/KTOfficialCandidatesWriter.cc",
        "ROOTSpectrogramWriter/KTROOTSpectrogramTypeWriterEventAnalysis.cc",
        "ROOTSpectrogramWriter/KTROOTSpectrogramTypeWriterSpectrumAnalysis.cc",
        "ROOTSpectrogramWriter/KTROOTSpectrogramTypeWriterTransform.cc",
        "ROOTSpectrogramWriter/KTROOTSpectrogramWriter.cc",
        "ROOTTreeWriter/KTROOTTreeTypeWriterEventAnalysis.cc",
        "ROOTTreeWriter/KTROOTTreeTypeWriterSpectrumAnalysis.cc",
        "ROOTTreeWriter/KTROOTTreeTypeWriterTime.cc",
        "ROOTTreeWriter/KTROOTTreeWriter.cc",
        "TerminalWriter/KTTerminalTypeWriterEventAnalysis.cc",
        "TerminalWriter/KTTerminalTypeWriterTime.cc",
        "TerminalWriter/KTTerminalWriter.cc",
        ":IODict_cxx",
    ],
    # ROOT's class loader looks for the generated .pcm file next to the compiled library at
    # runtime, not just at compile time, so it needs to be a runtime dependency.
    data = [":IODict_pcm"],
    deps = [":katydid_io_headers"],
)

# A real, standalone .so, matching the CMake build's own libKatydidIO.so. Keeps the name
# katydid_io: every existing consumer's own deps entry for headers is unaffected (still
# //Source/IO:katydid_io_headers); dynamic_deps carries the genuine runtime dependency on
# libKatydidData.so/libKatydidUtility.so/libCicada_Katydid.so.
cc_shared_library(
    name = "katydid_io",
    dynamic_deps = [
        "//Source/Data:katydid_data",
        "//Source/Utility:katydid_utility",
        "@cicada",
        "@nymph",
        "@scarab",
    ],
    shared_lib_name = "libKatydidIO.so",
    deps = [":katydid_io_lib"],
)
