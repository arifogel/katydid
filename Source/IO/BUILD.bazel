# Drop this file at Source/IO/BUILD.bazel in the actual katydid checkout.
#
# Mirrors Source/IO/CMakeLists.txt's IO_HEADERFILES/IO_SOURCEFILES exactly (not globbed).
# HDF5Writer/* and ImageWriter/* excluded: Katydid_USE_HDF5's whole block is commented out at
# the top level (HDF5_FOUND never true in this project's actual config) and Magick++/GraphicsMagick
# is likewise never enabled (Katydid_USE_MAGICKPP off by default) - matches the real build, not
# a simplification. KTSpec1Reader.cc/.hh (which needs Monarch's M3*.hh headers) is correctly
# excluded too - it was never in IO_SOURCEFILES to begin with, independent of Katydid_USE_MONARCH.
#
# Unlike Transform/EventAnalysis (dictionary logic fully commented out in this branch), IO's
# ROOT_GENERATE_DICTIONARY call is real and active - this is the third and last dictionary
# module (after Utility and Cicada).
#
# NOT YET BUILT/TESTED. Verified by #include inspection: needs @cicada//:cicada (only
# Conversions/KT2ROOT.cc touches it, for CClassifierResultsData.hh etc.) and vendor/RapidXML
# (only KTDPTReader.cc touches it) in addition to what Utility+Data already provide.
#
# Include paths: the original top-level CMakeLists.txt adds each IO subdirectory as its own
# top-level include_directories() entry (not a subdir-prefixed style like Data/Cicada) - code
# elsewhere does `#include "KTBasicROOTFileWriter.hh"` etc. with no subdirectory prefix. Mirrored
# exactly below rather than guessed, to match how consumers (Transform, EventAnalysis,
# SpectrumAnalysis) will actually reference these headers.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tools:root_dictionary.bzl", "root_dictionary")

package(default_visibility = ["//visibility:public"])

_IO_INCLUDES = [
    ".",
    "BasicAsciiWriter",
    "BasicROOTFileWriter",
    "Conversions",
    "DataDisplay",
    "JSONWriter",
    "MultiSliceROOTWriter",
    "OfficialCandidatesWriter",
    "ROOTSpectrogramWriter",
    "ROOTTreeWriter",
    "TerminalWriter",
]

_IO_HDRS = glob([
    "*.hh",
    "BasicAsciiWriter/*.hh",
    "BasicROOTFileWriter/*.hh",
    "Conversions/*.hh",
    "DataDisplay/*.hh",
    "JSONWriter/*.hh",
    "MultiSliceROOTWriter/*.hh",
    "OfficialCandidatesWriter/*.hh",
    "ROOTSpectrogramWriter/*.hh",
    "ROOTTreeWriter/*.hh",
    "TerminalWriter/*.hh",
])

# Headers-only target so root_dictionary() below sees the real transitive include graph
# (Utility/Data/Nymph/Scarab/Boost/ROOT/Cicada), without depending on the full katydid_io
# library, which would be circular (katydid_io's srcs include the dictionary this generates).
cc_library(
    name = "katydid_io_headers",
    hdrs = _IO_HDRS,
    includes = _IO_INCLUDES,
    deps = [
        "//Source/Data:katydid_data",
        "//Source/Utility:katydid_utility",
        "//vendor/RapidXML:rapidxml",
        "@cicada",
    ],
)

root_dictionary(
    name = "IODict",
    headers = [
        "DataDisplay/KTDisplayWindow.hh",
        "Conversions/KTROOTData.hh",
    ],
    linkdef = "LinkDef/IOLinkDef.hh",
    deps = [":katydid_io_headers"],
)

cc_library(
    name = "katydid_io",
    srcs = [
        "BasicAsciiWriter/KTBasicASCIITypeWriterTS.cc",
        "BasicAsciiWriter/KTBasicAsciiWriter.cc",
        "BasicROOTFileWriter/KTBasicROOTFileWriter.cc",
        "BasicROOTFileWriter/KTBasicROOTTypeWriterEventAnalysis.cc",
        "BasicROOTFileWriter/KTBasicROOTTypeWriterSpectrumAnalysis.cc",
        "BasicROOTFileWriter/KTBasicROOTTypeWriterTime.cc",
        "BasicROOTFileWriter/KTBasicROOTTypeWriterTransform.cc",
        "Conversions/KT2ROOT.cc",
        "Conversions/KTROOTData.cc",
        "DataDisplay/KTDataDisplay.cc",
        "DataDisplay/KTDataTypeDisplayEventAnalysis.cc",
        "DataDisplay/KTDataTypeDisplaySpectrumAnalysis.cc",
        "DataDisplay/KTDataTypeDisplayTime.cc",
        "DataDisplay/KTDataTypeDisplayTransform.cc",
        "DataDisplay/KTDisplayWindow.cc",
        "JSONWriter/KTJSONTypeWriterEventAnalysis.cc",
        "JSONWriter/KTJSONTypeWriterTime.cc",
        "JSONWriter/KTJSONWriter.cc",
        "KTDPTReader.cc",
        "KTLongSpecProcessor.cc",
        "KTMultiFileROOTTreeReader.cc",
        "KTRFSlewtoVec.cc",
        "KTROOTWriterFileManager.cc",
        "KTSpecProcessor.cc",
        "KTSpecReader.cc",
        "KTSpeckProcessor.cc",
        "MultiSliceROOTWriter/KTMultiSliceROOTTypeWriterSpectrumAnalysis.cc",
        "MultiSliceROOTWriter/KTMultiSliceROOTTypeWriterTime.cc",
        "MultiSliceROOTWriter/KTMultiSliceROOTTypeWriterTransform.cc",
        "MultiSliceROOTWriter/KTMultiSliceROOTWriter.cc",
        "OfficialCandidatesWriter/KTOfficialCandidatesWriter.cc",
        "ROOTSpectrogramWriter/KTROOTSpectrogramTypeWriterEventAnalysis.cc",
        "ROOTSpectrogramWriter/KTROOTSpectrogramTypeWriterSpectrumAnalysis.cc",
        "ROOTSpectrogramWriter/KTROOTSpectrogramTypeWriterTransform.cc",
        "ROOTSpectrogramWriter/KTROOTSpectrogramWriter.cc",
        "ROOTTreeWriter/KTROOTTreeTypeWriterEventAnalysis.cc",
        "ROOTTreeWriter/KTROOTTreeTypeWriterSpectrumAnalysis.cc",
        "ROOTTreeWriter/KTROOTTreeTypeWriterTime.cc",
        "ROOTTreeWriter/KTROOTTreeWriter.cc",
        "TerminalWriter/KTTerminalTypeWriterEventAnalysis.cc",
        "TerminalWriter/KTTerminalTypeWriterTime.cc",
        "TerminalWriter/KTTerminalWriter.cc",
        ":IODict_cxx",
    ],
    hdrs = _IO_HDRS,
    data = [":IODict_pcm"],
    includes = _IO_INCLUDES,
    deps = [
        "//Source/Data:katydid_data",
        "//Source/Utility:katydid_utility",
        "//vendor/RapidXML:rapidxml",
        "@cicada",
    ],
)
