# Builds Katydid's Transform module: window functions and forward/reverse FFTs for converting
# time series data into frequency-domain spectra.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

# Headers and consumer-visible compile flags (includes) -- the only target anything outside
# this package depends on for compile-time visibility. cc_shared_library has no
# defines/includes/hdrs attribute, so these must live here, not on katydid_transform_lib below.
#
# Depends on other modules' own _headers targets, not the modules themselves: cc_shared_library
# produces no CcInfo, so a plain cc_library can only reach another via dynamic_deps, for the
# runtime link, never directly for headers.
cc_library(
    name = "katydid_transform_headers",
    hdrs = glob(["*.hh"]),
    includes = ["."],
    deps = [
        "//Source/Data:katydid_data_headers",
        "//Source/IO:katydid_io_headers",
        "//Source/Utility:katydid_utility_headers",
    ],
)

# The compiled code. cc_shared_library's deps attribute whole-archives everything here into the
# shared library unconditionally, giving KT_REGISTER_PROCESSOR/READER/WRITER/EGGREADER's
# static-initializer registration the same guarantee alwayslink = 1 gave under static linking.
# Nothing outside this package depends on this directly -- only :katydid_transform_headers
# (headers) and :katydid_transform (runtime link) do.
cc_library(
    name = "katydid_transform_lib",
    srcs = [
        "KTBlackmanHarrisWindow.cc",
        "KTConvertToPower.cc",
        "KTFFT.cc",
        "KTForwardFFTW.cc",
        "KTFractionalFFT.cc",
        "KTHammingWindow.cc",
        "KTHannWindow.cc",
        "KTRectangularWindow.cc",
        "KTReverseFFTW.cc",
        "KTSincWindow.cc",
        "KTWindowFunction.cc",
        "KTWindower.cc",
    ],
    deps = [":katydid_transform_headers"],
)

# A real, standalone .so, matching the CMake build's libKatydidTransform.so. Keeps the name
# katydid_transform so existing consumers' headers deps
# (//Source/Transform:katydid_transform_headers) stay valid; dynamic_deps carries the runtime
# dependency on libKatydidData.so/libKatydidIO.so/libKatydidUtility.so.
cc_shared_library(
    name = "katydid_transform",
    dynamic_deps = [
        "//Source/Data:katydid_data",
        "//Source/IO:katydid_io",
        "//Source/Utility:katydid_utility",
        "@nymph",
        "@scarab",
    ],
    shared_lib_name = "libKatydidTransform.so",
    deps = [":katydid_transform_lib"],
)
