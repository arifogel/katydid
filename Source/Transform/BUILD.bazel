# Builds Katydid's Transform module: window functions and forward/reverse FFTs for converting
# time series data into frequency-domain spectra.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "katydid_transform",
    srcs = [
        "KTBlackmanHarrisWindow.cc",
        "KTConvertToPower.cc",
        "KTFFT.cc",
        "KTForwardFFTW.cc",
        "KTFractionalFFT.cc",
        "KTHammingWindow.cc",
        "KTHannWindow.cc",
        "KTRectangularWindow.cc",
        "KTReverseFFTW.cc",
        "KTSincWindow.cc",
        "KTWindowFunction.cc",
        "KTWindower.cc",
    ],
    hdrs = glob(["*.hh"]),
    includes = ["."],
    deps = [
        "//Source/Data:katydid_data",
        "//Source/IO:katydid_io",
        "//Source/Utility:katydid_utility",
    ],
    # KT_REGISTER_PROCESSOR/READER/WRITER/EGGREADER register into Katydid's
    # runtime factories purely via static-initializer side effects -- no
    # other code calls these translation units by symbol. Without
    # alwayslink, the linker drops them as dead code and every processor
    # defined here (window functions and transform processors) silently fails to
    # register at runtime.
    alwayslink = 1,
)
