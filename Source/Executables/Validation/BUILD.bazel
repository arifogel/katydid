# ROOT's Cling interpreter looks for a dictionary's _rdict.pcm file directly alongside the
# consuming binary's own bazel-out bin/ directory, not via Bazel's runfiles tree - a hazard for
# any binary that lives in a different Bazel package than the one that generated the
# dictionary (see //Source/IO:IODict_pcm's and @cicada//:CicadaDict_pcm's own root_dictionary()
# calls). Most code tolerates the resulting "PCM file does not exist" as a harmless warning, but
# classes used via TClonesArray need the PCM for streamer-info lookup and crash without it:
# KTROOTData.hh's TDiscriminatedPoint/TSparseWaterfallCandidateData (IODict) and Cicada's
# TProcessedTrackData/TMultiTrackEventData (CicadaDict), both written here via
# KTROOTTreeTypeWriterEventAnalysis. These genrules copy each dictionary's PCM to a plain
# output in this package, which Bazel builds directly into this package's own bazel-out bin/
# directory - exactly the path Cling looks in, since genrule outputs are never placed inside a
# runfiles tree in the first place. Both are wired into every test here that could plausibly
# write these classes, not just the ones that have already crashed on it - the failure only
# shows up once the write path is actually exercised, which varies with the test's random data.
genrule(
    name = "IODict_pcm_local_copy",
    srcs = ["//Source/IO:IODict_pcm"],
    outs = ["IODict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

genrule(
    name = "CicadaDict_pcm_local_copy",
    srcs = ["@cicada//:CicadaDict_pcm"],
    outs = ["CicadaDict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

cc_test(
    name = "TestWindowFunction",
    srcs = ["TestWindowFunction.cc"],
    deps = ["//Source/Transform:katydid_transform"],
)

# --- ROOT-required tier -------------------------------------------------------------------
#
# TestROOTDictionary and TestROOTTreeWritingViaCicada both touch classes used via TClonesArray
# (Cicada::TProcessedTrackData/TMultiTrackEventData), so both carry the CicadaDict PCM copy
# genrule defined above, for the same reason TestTrackProcessing and TestSequentialTrackFinder
# needed it - see that genrule's own comment for the full mechanism. TestROOTDictionary's own
# lookup uses TClass::GetClass(name, false), which skips ROOT's autoload/autoparse fallback
# entirely, so it likely doesn't strictly need the PCM - it's included anyway since it costs
# nothing and keeps this consistent with every other target that references these classes.
#
# TestROOTDictionary needs @cicada directly rather than katydid_io: it includes CROOTData.hh
# itself, with no Katydid-specific wrapping around Cicada's classes.

cc_test(
    name = "TestBackgroundFlattening",
    srcs = ["TestBackgroundFlattening.cc"],
    deps = [
        "//Source/IO:katydid_io",
        "//Source/SpectrumAnalysis:katydid_spectrum_analysis",
    ],
)

cc_test(
    name = "TestBasicROOTFileWriter",
    srcs = ["TestBasicROOTFileWriter.cc"],
    deps = ["//Source/IO:katydid_io"],
)

cc_test(
    name = "TestROOTDictionary",
    srcs = ["TestROOTDictionary.cc"],
    data = [":CicadaDict_pcm_local_copy"],
    # @cicada does not depend on @nymph (see its own BUILD file's top comment) - this is the
    # only test here whose deps are just @cicada, with nothing that transitively provides
    # Nymph's KTLogger.hh, which this test also includes directly. Every other test gets
    # KTLogger.hh for free through one of the katydid_* libraries, which all depend on @nymph.
    deps = [
        "@cicada",
        "@nymph",
    ],
)

cc_test(
    name = "TestROOTTreeWritingViaCicada",
    srcs = ["TestROOTTreeWritingViaCicada.cc"],
    data = [
        ":CicadaDict_pcm_local_copy",
        ":IODict_pcm_local_copy",
    ],
    deps = ["//Source/IO:katydid_io"],
)

cc_test(
    name = "TestROOTWriterFileManager",
    srcs = ["TestROOTWriterFileManager.cc"],
    deps = ["//Source/IO:katydid_io"],
)
