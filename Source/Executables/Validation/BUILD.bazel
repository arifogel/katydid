# ROOT's Cling interpreter looks for a dictionary's _rdict.pcm file directly alongside the
# consuming binary's own bazel-out bin/ directory, not via Bazel's runfiles tree - a hazard for
# any binary that lives in a different Bazel package than the one that generated the
# dictionary (see //Source/IO:IODict_pcm's and @cicada//:CicadaDict_pcm's own root_dictionary()
# calls). Most code tolerates the resulting "PCM file does not exist" as a harmless warning, but
# classes used via TClonesArray need the PCM for streamer-info lookup and crash without it:
# KTROOTData.hh's TDiscriminatedPoint/TSparseWaterfallCandidateData (IODict) and Cicada's
# TProcessedTrackData/TMultiTrackEventData (CicadaDict), both written here via
# KTROOTTreeTypeWriterEventAnalysis. These genrules copy each dictionary's PCM to a plain
# output in this package, which Bazel builds directly into this package's own bazel-out bin/
# directory - exactly the path Cling looks in, since genrule outputs are never placed inside a
# runfiles tree in the first place. Both are wired into every test here that could plausibly
# write these classes, not just the ones that have already crashed on it - the failure only
# shows up once the write path is actually exercised, which varies with the test's random data.
genrule(
    name = "IODict_pcm_local_copy",
    srcs = ["//Source/IO:IODict_pcm"],
    outs = ["IODict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

genrule(
    name = "CicadaDict_pcm_local_copy",
    srcs = ["@cicada//:CicadaDict_pcm"],
    outs = ["CicadaDict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

