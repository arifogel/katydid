# Ports the "Utility tests" tier of Source/Executables/Validation/CMakeLists.txt (the programs
# listed there as needing only KatydidUtility, not ROOT/FFTW/Monarch) to real Bazel cc_test
# targets, so they participate in `bazel test //...` with correct per-target pass/fail tracking.
#
# These are small, pre-existing validation programs, not a rigorous test suite: most exercise a
# class and log its behavior without checking the result against a known-correct value (a
# genuine smoke test, not a regression test), and only some (TestAxisProperties, TestCutableArray,
# TestCutIterator) check for an internal error condition and exit non-zero on failure. None of
# that behavior is being added or changed here - this only gives Bazel's test runner visibility
# into pass/fail signals that already exist in the program logic, in place of the original CMake
# build's CI/test.sh, which ran several of these as a plain, unchecked shell script (no `set -e`,
# so an earlier failure did not actually fail the CI job).
#
# TestAxisProperties and TestDBSCAN include ROOT headers directly, despite CMake's own "does NOT
# require ROOT" categorization for this tier - both guard that usage with #ifdef ROOT_FOUND
# (confirmed by inspection), the same pattern used throughout the rest of the codebase, so this
# is safe given ROOT_FOUND is always defined in this build.
#
# TestDBSCAN also needs a header (KTDistanceMatrix.hh) that is header-only and, despite this
# tier's "Utility only" categorization, actually lives in Source/EventAnalysis, not
# Source/Utility - confirmed by inspection, not an error in this file. Depending on the full
# katydid_event_analysis library is heavier than strictly needed just for one header, but is the
# correct and simplest way to make it visible, and costs nothing meaningful for a test target.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

_UTILITY_TEST_DEPS = ["//Source/Utility:katydid_utility"]

cc_test(
    name = "ObjectSize",
    srcs = ["ObjectSize.cc"],
    deps = _UTILITY_TEST_DEPS,
)

cc_test(
    name = "TestAxisProperties",
    srcs = ["TestAxisProperties.cc"],
    deps = _UTILITY_TEST_DEPS,
)

cc_test(
    name = "TestComplexPolar",
    srcs = ["TestComplexPolar.cc"],
    deps = _UTILITY_TEST_DEPS,
)

cc_test(
    name = "TestCutableArray",
    srcs = ["TestCutableArray.cc"],
    deps = _UTILITY_TEST_DEPS,
)

cc_test(
    name = "TestCutIterator",
    srcs = ["TestCutIterator.cc"],
    deps = _UTILITY_TEST_DEPS,
)

cc_test(
    name = "TestDBSCAN",
    srcs = ["TestDBSCAN.cc"],
    deps = _UTILITY_TEST_DEPS + ["//Source/EventAnalysis:katydid_event_analysis"],
)

cc_test(
    name = "TestMinMaxBin",
    srcs = ["TestMinMaxBin.cc"],
    deps = _UTILITY_TEST_DEPS,
)

cc_test(
    name = "TestNanoflann",
    srcs = ["TestNanoflann.cc"],
    deps = _UTILITY_TEST_DEPS + ["//vendor/nanoflann"],
)

cc_test(
    name = "TestRandom",
    srcs = ["TestRandom.cc"],
    deps = _UTILITY_TEST_DEPS,
)

cc_test(
    name = "TestVector",
    srcs = ["TestVector.cc"],
    deps = _UTILITY_TEST_DEPS,
)

# --- "Data & IO tests" tier ---------------------------------------------------------------
#
# TestDataDisplay is deliberately NOT ported here, as either a cc_test or a cc_binary: reading
# its source shows it opens real ROOT GUI windows (TCanvas) and blocks twice on `cin >> resp`
# waiting for interactive y/n keyboard input. There is no way to run this automatically in CI -
# it would hang indefinitely (no TTY, no display server). It remains a manual-only program,
# outside the Bazel build, the same way Source/Time, Source/Simulation, and Source/Evaluation
# are not built at all.
#
# TestDPTReader is a cc_binary, not a cc_test: it requires a .dpt data file to be given as a
# command-line argument, and - importantly - returns 0 (success) when none is given. No sample
# .dpt file exists anywhere in this repository (checked), and it was never part of the original
# CMake build's own CI/test.sh either. Wiring it up as a "test" with no real input would trivially
# pass every time without checking anything, which would be actively misleading. As a cc_binary
# it's still compile-checked by `bazel build //...`, just not claimed as a real automated test.
#
# TestJSONWriter, TestKDTree, TestKDTreeData, and TestSmoothing are smoke tests only (like most
# of the Utility tier above) - none contain an assertion or comparison against a known-correct
# value, they construct/exercise a class and log the result. TestJSONWriter and TestSmoothing
# write scratch files (test_writer.json, TestSmoothing.root respectively) to their own working
# directory, which Bazel's test sandbox allows without any special configuration.

_DATA_IO_TEST_DEPS = [
    "//Source/Data:katydid_data",
    "//Source/IO:katydid_io",
    "//Source/Utility:katydid_utility",
]

cc_binary(
    name = "TestDPTReader",
    srcs = ["TestDPTReader.cc"],
    deps = _DATA_IO_TEST_DEPS,
)

cc_test(
    name = "TestJSONWriter",
    srcs = ["TestJSONWriter.cc"],
    deps = _DATA_IO_TEST_DEPS,
)

cc_test(
    name = "TestKDTree",
    srcs = ["TestKDTree.cc"],
    deps = _DATA_IO_TEST_DEPS + ["//vendor/nanoflann"],
)

cc_test(
    name = "TestKDTreeData",
    srcs = ["TestKDTreeData.cc"],
    deps = _DATA_IO_TEST_DEPS,
)

cc_test(
    name = "TestSmoothing",
    srcs = ["TestSmoothing.cc"],
    deps = _DATA_IO_TEST_DEPS,
)

