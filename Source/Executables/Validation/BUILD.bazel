# Ports Source/Executables/Validation/CMakeLists.txt's various test programs to real Bazel
# cc_test/cc_binary targets, so they participate in `bazel test //...` with correct per-target
# pass/fail tracking.
#
# These are small, pre-existing validation programs, not a rigorous test suite: most exercise a
# class and log its behavior without checking the result against a known-correct value (a
# genuine smoke test, not a regression test), and only some (TestAxisProperties, TestCutableArray,
# TestCutIterator, TestCorrelator, TestSpectrumDiscriminator, TestTrackProcessing) check for an
# internal error condition and exit non-zero on failure. None of that behavior is being added or
# changed here - this only gives Bazel's test runner visibility into pass/fail signals that
# already exist in the program logic, in place of the original CMake build's CI/test.sh, which ran
# several of these as a plain, unchecked shell script (no `set -e`, so an earlier failure did not
# actually fail the CI job).
#
# TestAxisProperties and TestDBSCAN include ROOT headers directly, despite CMake's own "does NOT
# require ROOT" categorization for the tier they originally came from - both guard that usage
# with #ifdef ROOT_FOUND (confirmed by inspection), the same pattern used throughout the rest of
# the codebase, so this is safe given ROOT_FOUND is always defined in this build.
#
# TestDataDisplay is deliberately NOT ported here, as either a cc_test or a cc_binary: reading
# its source shows it opens real ROOT GUI windows (TCanvas) and blocks twice on `cin >> resp`
# waiting for interactive y/n keyboard input. There is no way to run this automatically in CI -
# it would hang indefinitely (no TTY, no display server). It remains a manual-only program,
# outside the Bazel build, the same way Source/Time, Source/Simulation, and Source/Evaluation
# are not built at all.
#
# TestDPTReader is a cc_binary, not a cc_test: it requires a .dpt data file to be given as a
# command-line argument, and - importantly - returns 0 (success) when none is given. No sample
# .dpt file exists anywhere in this repository (checked), and it was never part of the original
# CMake build's own CI/test.sh either. Wiring it up as a "test" with no real input would trivially
# pass every time without checking anything, which would be actively misleading. As a cc_binary
# it's still compile-checked by `bazel build //...`, just not claimed as a real automated test.
#
# Test2DDiscrim is NOT ported here: it directly constructs a KTSpline object
# (`new KTSpline(xVals, yVals, 3)`), and that constructor's only definition is in
# Source/Utility/KTSpline.cc, which is excluded from the build (see NOTES.md - KTSpline.cc's
# Implement() signature doesn't match its own header). This would fail to link, not because of
# anything in this port, but because of that pre-existing exclusion.
#
# Every cc_test/cc_binary below lists two kinds of dependency: `deps` on every module's own
# `_headers` target, for compile-time visibility of whatever the test's own .cc file
# #includes, and `dynamic_deps` on every module's own cc_shared_library target, for the actual
# runtime link -- cc_shared_library provides no CcInfo at all, so headers and the runtime link
# have to be reached through two separate targets. See //Source/Utility:katydid_utility_headers'
# own comment for the full reasoning.
#
# Every test below (other than TestROOTDictionary) is given the FULL set of Katydid module
# .so's via dynamic_deps, not just whichever module its own .cc file most directly concerns -
# deliberately, not out of laziness. dynamic_deps is transitive only for deciding which
# cc_librarys should NOT be statically duplicated (bazel's own documented behavior) - it does
# NOT cause a final cc_binary/cc_test's own link command to include every transitively-nested
# .so as well. So a test that dynamic_deps's only on, say, katydid_spectrum_analysis, but whose
# own .cc file (or a header it includes) directly references a Nymph::KTLogger or
# scarab::logger symbol - true of nearly every Katydid header, via a pervasive logging macro -
# fails to link with "undefined reference", even though katydid_spectrum_analysis itself
# genuinely does depend on Nymph/Scarab at runtime: that dependency is real but only visible to
# katydid_spectrum_analysis.so's own DT_NEEDED, not consulted by the linker when resolving the
# separate, final test binary's own undefined symbols (confirmed empirically: this file
# originally scoped dynamic_deps per-tier, matching only the most directly relevant module, and
# the vast majority of targets built that way failed exactly this way). This is the same
# "link everything, let the linker sort it out" approach already used successfully for
# Source/Executables/Main's own Katydid_bin/Truncate_bin (see that file's own
# _ALL_KATYDID_LIBS/_ALL_KATYDID_HEADERS) and, separately, for ROOT's own libraries in
# tools/system_deps.bzl - matching the reference CMake build's own approach directly, which
# links its own full external+internal library set into every executable the same way.
#
# TestROOTDictionary is the one exception, kept deliberately narrow: it depends on @cicada and
# @nymph only, nothing else, specifically to test dictionary registration in as close to
# isolation as this codebase allows.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

_ALL_KATYDID_HEADERS = [
    "//Source/Data:katydid_data_headers",
    "//Source/EventAnalysis:katydid_event_analysis_headers",
    "//Source/IO:katydid_io_headers",
    "//Source/SpectrumAnalysis:katydid_spectrum_analysis_headers",
    "//Source/Transform:katydid_transform_headers",
    "//Source/Utility:katydid_utility_headers",
    "@cicada//:cicada_headers",
]

# The actual .so's: for the runtime link. See this file's own top comment for why every test
# gets the full set, not just whichever module it most directly concerns.
_ALL_KATYDID_LIBS = [
    "//Source/Data:katydid_data",
    "//Source/EventAnalysis:katydid_event_analysis",
    "//Source/IO:katydid_io",
    "//Source/SpectrumAnalysis:katydid_spectrum_analysis",
    "//Source/Transform:katydid_transform",
    "//Source/Utility:katydid_utility",
    "@cicada",
    "@nymph",
    "@scarab",
]

# Cling's runtime autoloader looks up dictionary headers by bare basename (see
# tools/root_dictionary.bzl) in the directory next to the running binary. @cicada's own `data`
# isn't enough; this needs to physically sit in this package's own bazel-out bin/ directory.
# Without it, autoloading fails with "Missing FileEntry for _CROOTData.hh" -- non-fatal, but
# affects every test that touches @cicada, directly or transitively - which, given every test
# below now depends on @cicada via _ALL_KATYDID_LIBS/_ALL_KATYDID_HEADERS, means all of them.
genrule(
    name = "CicadaDict_header_local_copy",
    srcs = ["@cicada//:Library/_CROOTData.hh"],
    outs = ["_CROOTData.hh"],
    cmd = "cp $< $@",
)

_CICADA_HEADER_DATA = [":CicadaDict_header_local_copy"]

cc_test(
    name = "ObjectSize",
    srcs = ["ObjectSize.cc"],
    data = _CICADA_HEADER_DATA,
    dynamic_deps = _ALL_KATYDID_LIBS,
    deps = _ALL_KATYDID_HEADERS,
)

