# Builds the Katydid and Truncate command-line programs. Both link against every Katydid
# module, matching how they are built in the CMake/Docker workflow.
#
# EggScanner and RSAMatToEgg are not built here: both require Monarch (Katydid's raw egg-file
# reading library), which is off by Katydid's default configuration.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

_ALL_KATYDID_LIBS = [
    "//Source/Data:katydid_data",
    "//Source/EventAnalysis:katydid_event_analysis",
    "//Source/IO:katydid_io",
    "//Source/SpectrumAnalysis:katydid_spectrum_analysis",
    "//Source/Transform:katydid_transform",
    "//Source/Utility:katydid_utility",
]

# IODict/CicadaDict's own compiled dictionary code, kept out of katydid_io/cicada's own static
# srcs deliberately: TCling::RegisterModule (ROOT's own function, inside libCore.so) already
# calls dlopen() itself, unconditionally, on whatever file it resolves as containing a
# dictionary's compiled code, as part of finishing registration -- no hook of ours involved.
# Today that resolves to Katydid/Truncate's own main executable, since that's genuinely where
# this code is linked -- and a PIE main executable was never a properly supported dlopen()
# target (glibc >= 2.29 refuses it outright; other toolchains that don't flag the binary PIE
# leave registration silently incomplete instead). Moving this code into a real, separate .so
# makes that same, already-existing dlopen() call resolve to a genuine shared library instead,
# with no new code needed anywhere.
#
# A plain cc_binary(linkshared = True), not cc_shared_library: the latter's own ODR-checking
# and direct-vs-transitive exports bookkeeping turned out to have three separate, real problems
# for this specific use -- an analysis-time error for any library also statically linked
# elsewhere, a still-open upstream bug dropping linkopts from srcs-less deps
# (bazelbuild/bazel#21884/#27247), and a still-open upstream limitation where a consumer's own
# direct references to a dependency's inline/header-embedded symbols go unresolved if that
# dependency is only reachable via dynamic_deps (bazelbuild/bazel#21819) -- none of which apply
# to this much older, simpler mechanism, which just compiles srcs and links deps into a .so the
# same way it would build a normal executable.
cc_binary(
    name = "libroot_dict_shared.so",
    srcs = [
        "//Source/IO:IODict_cxx",
        "@cicada//:CicadaDict_cxx",
    ],
    linkshared = True,
    # //Source/IO:katydid_io_root_types, not the real, full katydid_io: the dictionary needs
    # the real, compiled implementation of the specific classes it registers (KTROOTData.cc/
    # KTDisplayWindow.cc, split out into that narrower target for exactly this) to resolve
    # their typeinfo/vtable symbols at this .so's own link time (confirmed directly:
    # TestROOTDictionary, which links @cicada alone, not katydid_io, failed at runtime with
    # "undefined symbol: typeinfo for Katydid::TMultiBandEventData" without this) -- but
    # linking the real, full katydid_io instead, which was tried first, hit a second, real
    # problem: its own writer/reader/processor classes' KT_REGISTER_* static-initializer
    # registration ran a second time in the same process, once for their own copy already
    # statically linked into Katydid/Truncate/every Validation test, and again for the
    # separate copy that pulled into this .so -- confirmed directly against real output
    # ("Already have factory registered for <json>", <yaml>, <basic-ascii-writer>, and every
    # other katydid_io writer/processor/reader). katydid_io_root_types carries no such
    # registration side effects (confirmed directly, not assumed: grepped for KT_REGISTER_* in
    # each of its three source files first), so this avoids that problem entirely rather than
    # trading it for a narrower one.
    #
    # @cicada, not split the same way: cicada is a data-format library, not a processing-
    # pipeline component, and no Cicada-specific double-registration appeared in the actual
    # observed output above -- reasonable evidence it doesn't have the same problem, though
    # this repo doesn't carry Cicada's own source to grep directly the way katydid_io's could
    # be checked, so this is inference from behavior, not a source-level check.
    deps = [
        "//Source/IO:katydid_io_root_types",
        "@cicada",
    ],
)

# Wraps the .so above as a normal, plain deps entry: ensures Katydid/Truncate/etc. link against
# it as a genuine runtime dependency (a real DT_NEEDED entry, with bazel's own standard rpath
# handling), so the OS's own dynamic loader loads it at process start and its own static
# initializer -- the one that calls TCling::RegisterModule -- actually runs.
cc_import(
    name = "root_dict_import",
    shared_library = ":libroot_dict_shared.so",
)

# Every target below that links any of katydid_io/katydid_transform/
# katydid_spectrum_analysis/katydid_event_analysis/@cicada (directly or
# transitively) needs this too, for the dictionary to be registered.
_ROOT_DICT_DEPS = [":root_dict_import"]

# ROOT's Cling interpreter looks for a dictionary's _rdict.pcm file directly alongside the
# consuming binary's own bazel-out bin/ directory, not via Bazel's runfiles tree. katydid_io
# and @cicada each already declare `data = [":<name>_pcm"]` on their own cc_library, but that
# only places the PCM in the runfiles tree of whatever consumes them - it does not solve the
# same-bazel-out-directory requirement, since a `cc_library`'s `data` doesn't relocate anything;
# it only propagates to consumers' runfiles. Katydid and Truncate both link katydid_io (which
# itself depends on @cicada), so both are exposed: if a config file run through Katydid ever
# exercises the ROOT-tree-writing path for classes used via TClonesArray - KTROOTData.hh's
# TDiscriminatedPoint/TSparseWaterfallCandidateData (IODict), or Cicada's
# TProcessedTrackData/TMultiTrackEventData (CicadaDict) - Cling falls back to re-parsing the
# dictionary's embedded payload at runtime and crashes when it can't find the PCM. This is the
# same crash Source/Executables/Validation:TestTrackProcessing and
# Source/Executables/Validation:TestSequentialTrackFinder hit and were fixed for, using the same
# technique here: copy each dictionary's PCM into this package's own bazel-out bin/ directory,
# which is exactly where Cling looks for a binary built here.
genrule(
    name = "IODict_pcm_local_copy",
    srcs = ["//Source/IO:IODict_pcm"],
    outs = ["IODict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

genrule(
    name = "CicadaDict_pcm_local_copy",
    srcs = ["@cicada//:CicadaDict_pcm"],
    outs = ["CicadaDict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

# CicadaDict's .rootmap records its dictionary headers by bare basename (see
# tools/root_dictionary.bzl), and Cling's runtime autoloader looks them up by that same
# basename, in this same directory, when it first encounters one of these types (observed
# for Cicada::TProcessedTrackData/TMultiTrackEventData specifically). Exposing the header via
# @cicada's own `data` isn't enough - like the PCM above, it needs to physically sit next to
# the binary in this package's own bazel-out bin/ directory, not just be reachable via
# runfiles.
genrule(
    name = "CicadaDict_header_local_copy",
    srcs = ["@cicada//:Library/_CROOTData.hh"],
    outs = ["_CROOTData.hh"],
    cmd = "cp $< $@",
)

_PCM_DATA = [
    ":CicadaDict_pcm_local_copy",
    ":CicadaDict_header_local_copy",
    ":IODict_pcm_local_copy",
]

cc_binary(
    name = "Katydid_bin",
    srcs = ["Katydid.cc"],
    deps = _ALL_KATYDID_LIBS + _ROOT_DICT_DEPS,
)

cc_binary(
    name = "Truncate_bin",
    srcs = ["Truncate.cc"],
    deps = _ALL_KATYDID_LIBS + _ROOT_DICT_DEPS,
)

# Wraps Katydid_bin/Truncate_bin: sets ROOT_INCLUDE_PATH *before* the real binary's own
# process starts, then execs it -- see root_include_path_wrapper.sh's own header comment for
# why this has to happen externally, from a wrapper, rather than from any code running inside
# the process itself (confirmed directly, via strace, that nothing set from inside the
# process -- however early -- ever reaches ROOT/Cling's actual autoload lookup). One shared
# script for both: it determines which real binary to exec from its own invoked name, so
# "Katydid"/"Truncate" each just need their own sh_binary using it.
#
# _PCM_DATA (not just the real binary) is still needed here, for the exact same reason it was
# needed directly on Katydid/Truncate before this wrapper existed: ROOT's Cling interpreter
# looks for these files sitting directly alongside whatever binary is actually running, not
# via Bazel's runfiles tree by itself -- see _PCM_DATA's own comment above.
sh_binary(
    name = "Katydid",
    srcs = ["root_include_path_wrapper.sh"],
    data = [":Katydid_bin"] + _PCM_DATA,
)

sh_binary(
    name = "Truncate",
    srcs = ["root_include_path_wrapper.sh"],
    data = [":Truncate_bin"] + _PCM_DATA,
)

# Regression test for two bugs, both since fixed. TCling::RegisterModule once ended up
# trying to dlopen() Katydid's own main executable -- never a properly supported dlopen()
# target, since IODict/CicadaDict's own compiled code was compiled into katydid_io/@cicada as
# plain cc_library sources rather than a genuine shared library; fixed by
# :libroot_dict_shared.so/:root_dict_import above. Separately, ROOT_INCLUDE_PATH needs to be
# set in the environment *before* Katydid's own process is created for ROOT/Cling's autoload
# machinery to see it at all -- fixed by :root_include_path_wrapper.sh above; see that file's
# own header comment for how this was diagnosed. See check_katydid_stderr_test.sh's own
# header for the full explanation of both original symptoms, including why the first one
# failed differently on the two platforms.
sh_test(
    name = "katydid_stderr_test",
    srcs = ["check_katydid_stderr_test.sh"],
    args = ["$(location :Katydid)"],
    data = [":Katydid"],
)

# Flat release archive: Katydid/Truncate (the wrapper scripts) plus Katydid_bin/Truncate_bin
# (the real binaries each wrapper execs) plus every file Cling's runtime dictionary/
# autoloading machinery needs sitting alongside them (see the genrules and
# root_include_path_wrapper.sh above for why each of these is here). Extracting this archive
# anywhere and running ./Katydid from that directory reproduces exactly the layout those
# mechanisms expect, with no separate runfiles tree required.
#
# Does NOT bundle ROOT/Boost/FFTW/etc: those are dynamically linked at fixed absolute paths
# (e.g. /opt/homebrew/opt/root/lib/root/libCore.so) and are assumed to already be present,
# in compatible versions, on any machine this archive is extracted on -- packaging shared
# library dependencies themselves is a separate, materially larger undertaking this doesn't
# attempt.
pkg_files(
    name = "katydid_release_binaries",
    srcs = [
        ":Katydid",
        ":Katydid_bin",
        ":Truncate",
        ":Truncate_bin",
    ],
    attributes = pkg_attributes(mode = "0755"),
    # strip_prefix defaults to strip_prefix.files_only(), flattening everything to the
    # archive root -- exactly what we want, since every file here already lives in this
    # same package (Source/Executables/Main) and none of that structure needs preserving.
)

pkg_files(
    name = "katydid_release_data",
    srcs = [
        ":CicadaDict_header_local_copy",
        ":CicadaDict_pcm_local_copy",
        ":IODict_pcm_local_copy",
    ],
    # default mode (0644) is correct for these -- data files, not executables.
)

# NOTICE.txt lives here, in this package, rather than at the repo root: its warning is
# specifically about the compiled binaries in the RELEASE ARCHIVE, not about this source
# repository (which is fine to share, per the notice's own first paragraph) -- keeping it
# next to the packaging code that actually bundles it avoids it being mistaken for a
# blanket statement about the whole repo if someone just browses the source tree.
#
# In the archive itself, both NOTICE.txt and Katydid's own LICENSE sit at the top level,
# next to the binaries -- maximally visible to anyone who opens the archive. See
# NOTICE.txt for the full explanation: to the best of our knowledge (NOT a legal
# determination), distributing the compiled binaries in this archive likely violates
# FFTW's GPL license, since Katydid's own license isn't GPL-compatible.
pkg_files(
    name = "katydid_release_notices",
    srcs = [
        "NOTICE.txt",
        "//:LICENSE",
    ],
)

# Every third-party license this binary is actually subject to (see NOTICE.txt), collected
# under a clearly-named subdirectory rather than flattened alongside everything else.
pkg_files(
    name = "katydid_release_third_party_licenses",
    srcs = ["//:third_party_licenses"],
    prefix = "third_party_licenses",
)

pkg_tar(
    name = "katydid_release",
    srcs = [
        ":katydid_release_binaries",
        ":katydid_release_data",
        ":katydid_release_notices",
        ":katydid_release_third_party_licenses",
    ],
    extension = "tar.gz",
)
