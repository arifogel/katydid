# Builds the Katydid and Truncate command-line programs. Both link against every Katydid
# module, matching how they are built in the CMake/Docker workflow.
#
# EggScanner and RSAMatToEgg are not built here: both require Monarch (Katydid's raw egg-file
# reading library), which is off by Katydid's default configuration.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Referenced by //:katydid_release -- a plain source file needs an explicit exports_files()
# entry to be visible from another package at all, regardless of this package's own
# default_visibility (which only applies to rule targets, not source files).
exports_files(["NOTICE.txt"])

_ALL_KATYDID_LIBS = [
    "//Source/Data:katydid_data",
    "//Source/EventAnalysis:katydid_event_analysis",
    "//Source/IO:katydid_io",
    "//Source/SpectrumAnalysis:katydid_spectrum_analysis",
    "//Source/Transform:katydid_transform",
    "//Source/Utility:katydid_utility",
]

# IODict/CicadaDict's own compiled dictionary code, kept out of katydid_io/cicada's own static
# srcs deliberately: TCling::RegisterModule (ROOT's own function, inside libCore.so) already
# calls dlopen() itself, unconditionally, on whatever file it resolves as containing a
# dictionary's compiled code, as part of finishing registration -- no hook of ours involved.
# Today that resolves to Katydid/Truncate's own main executable, since that's genuinely where
# this code is linked -- and a PIE main executable was never a properly supported dlopen()
# target (glibc >= 2.29 refuses it outright; other toolchains that don't flag the binary PIE
# leave registration silently incomplete instead). Moving this code into a real, separate .so
# makes that same, already-existing dlopen() call resolve to a genuine shared library instead,
# with no new code needed anywhere.
#
# A plain cc_binary(linkshared = True), not cc_shared_library: the latter's own ODR-checking
# and direct-vs-transitive exports bookkeeping turned out to have three separate, real problems
# for this specific use -- an analysis-time error for any library also statically linked
# elsewhere, a still-open upstream bug dropping linkopts from srcs-less deps
# (bazelbuild/bazel#21884/#27247), and a still-open upstream limitation where a consumer's own
# direct references to a dependency's inline/header-embedded symbols go unresolved if that
# dependency is only reachable via dynamic_deps (bazelbuild/bazel#21819) -- none of which apply
# to this much older, simpler mechanism, which just compiles srcs and links deps into a .so the
# same way it would build a normal executable.
cc_binary(
    name = "libroot_dict_shared.so",
    srcs = [
        "//Source/IO:IODict_cxx",
        "@cicada//:CicadaDict_cxx",
    ],
    linkshared = True,
    # //Source/IO:katydid_io_root_types, not the real, full katydid_io: the dictionary needs
    # the real, compiled implementation of the classes it registers (KTROOTData.cc/
    # KTDisplayWindow.cc, split out into that narrower target for exactly this) to resolve
    # their typeinfo/vtable symbols at this .so's own link time -- e.g.
    # Katydid::TMultiBandEventData's, defined in KTROOTData.cc. The real, full katydid_io
    # also carries every writer/reader/processor's own KT_REGISTER_* static-initializer
    # registration, which would run a second time in the same process: once for the copy
    # already statically linked into Katydid/Truncate/every Validation test, and again for a
    # separate copy in this .so. katydid_io_root_types carries no such registration side
    # effects (none of its three source files call KT_REGISTER_*), avoiding the problem
    # entirely rather than trading it for a narrower one.
    #
    # @cicada isn't split the same way: it's a data-format library, not a processing-pipeline
    # component, with no writer/reader/processor-style self-registration of its own to
    # duplicate.
    deps = [
        "//Source/IO:katydid_io_root_types",
        "@cicada",
    ],
)

# Wraps the .so above as a normal, plain deps entry: ensures Katydid/Truncate/etc. link against
# it as a genuine runtime dependency (a real DT_NEEDED entry, with bazel's own standard rpath
# handling), so the OS's own dynamic loader loads it at process start and its own static
# initializer -- the one that calls TCling::RegisterModule -- actually runs.
cc_import(
    name = "root_dict_import",
    shared_library = ":libroot_dict_shared.so",
)

# Every target below that links any of katydid_io/katydid_transform/
# katydid_spectrum_analysis/katydid_event_analysis/@cicada (directly or
# transitively) needs this too, for the dictionary to be registered.
_ROOT_DICT_DEPS = [":root_dict_import"]

# ROOT's Cling interpreter looks for a dictionary's _rdict.pcm file directly alongside
# whatever binary is actually running -- true of Katydid_bin/Truncate_bin themselves, run
# directly. katydid_io and @cicada each already declare `data = [":<name>_pcm"]` on their own
# cc_library, but that only places the PCM in the runfiles tree of whatever consumes them; a
# `cc_library`'s `data` doesn't relocate anything on its own. Katydid and Truncate both link
# katydid_io (which itself depends on @cicada), so both are exposed: if a config file run
# through Katydid ever exercises the ROOT-tree-writing path for classes used via
# TClonesArray - KTROOTData.hh's TDiscriminatedPoint/TSparseWaterfallCandidateData (IODict),
# or Cicada's TProcessedTrackData/TMultiTrackEventData (CicadaDict) - Cling falls back to
# re-parsing the dictionary's embedded payload at runtime and crashes when it can't find the
# PCM. This is the same crash Source/Executables/Validation:TestTrackProcessing and
# Source/Executables/Validation:TestSequentialTrackFinder hit and were fixed for, using the
# same technique here: copy each dictionary's PCM into this package's own bazel-out bin/
# directory, which is exactly where Cling looks for a binary built here -- and, via
# root_include_path_wrapper.sh's own use of the runfiles library (see below), exactly where
# Katydid/Truncate's own runfiles tree puts a copy too, so the same files serve both cases.
genrule(
    name = "IODict_pcm_local_copy",
    srcs = ["//Source/IO:IODict_pcm"],
    outs = ["IODict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

genrule(
    name = "CicadaDict_pcm_local_copy",
    srcs = ["@cicada//:CicadaDict_pcm"],
    outs = ["CicadaDict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

# CicadaDict's .rootmap records its dictionary headers by bare basename (see
# tools/root_dictionary.bzl), and Cling's runtime autoloader looks them up by that same
# basename, in this same directory, when it first encounters one of these types (observed
# for Cicada::TProcessedTrackData/TMultiTrackEventData specifically). Exposing the header via
# @cicada's own `data` isn't enough on its own - like the PCM above, it needs to physically
# sit next to whatever binary is actually running.
genrule(
    name = "CicadaDict_header_local_copy",
    srcs = ["@cicada//:Library/_CROOTData.hh"],
    outs = ["_CROOTData.hh"],
    cmd = "cp $< $@",
)

_PCM_DATA = [
    ":CicadaDict_pcm_local_copy",
    ":CicadaDict_header_local_copy",
    ":IODict_pcm_local_copy",
]

cc_binary(
    name = "Katydid_bin",
    srcs = ["Katydid.cc"],
    deps = _ALL_KATYDID_LIBS + _ROOT_DICT_DEPS,
)

cc_binary(
    name = "Truncate_bin",
    srcs = ["Truncate.cc"],
    deps = _ALL_KATYDID_LIBS + _ROOT_DICT_DEPS,
)

# Wraps Katydid_bin/Truncate_bin: sets ROOT_INCLUDE_PATH *before* the real binary's own
# process starts, then execs it -- see root_include_path_wrapper.sh's own header comment for
# why. katydid_launcher.sh/truncate_launcher.sh are each a tiny, target-specific entry point
# calling into that same, shared script, rather than root_include_path_wrapper.sh itself
# being each target's own srcs directly: confirmed directly, neither Bazel's args attribute
# (an earlier attempt at passing each target's own real binary location this way) nor $0/this
# script's own invoked name (an attempt before that) is reliable here. args never gets baked
# into the underlying file at all -- it's only applied by Bazel's own bazel run/test
# invocation machinery, absent whenever the file is invoked directly as a subprocess, which
# is exactly how this is actually used (the packaged release archive, katydid_stderr_test).
# $0 fares no better: nothing about how Bazel invokes a script guarantees it reflects the
# invoking target's own name, which broke specifically under use_bash_launcher, whose own
# generated launcher execs a script via its resolved runfiles path, resetting $0 to that path
# rather than the target's own name. A tiny, target-specific script with the real binary's
# own location hardcoded directly in its own source needs neither assumption at all.
#
# deps on the runfiles library directly (not use_bash_launcher): that attribute's own
# generated launcher looks for the library at the same path this target's own deps line
# makes it available at, but doesn't add the dependency itself -- confirmed directly, it
# failed with "ERROR: cannot find bazel_tools/tools/bash/runfiles/runfiles.bash" without
# this. Each launcher initializes the library itself instead, with its own official,
# verbatim init snippet.
#
# _PCM_DATA (not just the real binary) is needed here too, so these files are part of this
# target's own runfiles at all: ROOT's Cling interpreter looks for them sitting directly
# alongside whatever binary is actually running -- see _PCM_DATA's own comment above.
sh_binary(
    name = "Katydid",
    srcs = ["katydid_launcher.sh"],
    data = [
        ":Katydid_bin",
        ":root_include_path_wrapper.sh",
    ] + _PCM_DATA,
    deps = ["@rules_shell//shell/runfiles"],
)

sh_binary(
    name = "Truncate",
    srcs = ["truncate_launcher.sh"],
    data = [
        ":Truncate_bin",
        ":root_include_path_wrapper.sh",
    ] + _PCM_DATA,
    deps = ["@rules_shell//shell/runfiles"],
)

# Regression test for two bugs, both since fixed. TCling::RegisterModule once ended up
# trying to dlopen() Katydid's own main executable -- never a properly supported dlopen()
# target, since IODict/CicadaDict's own compiled code was compiled into katydid_io/@cicada as
# plain cc_library sources rather than a genuine shared library; fixed by
# :libroot_dict_shared.so/:root_dict_import above. Separately, ROOT_INCLUDE_PATH needs to be
# set in the environment *before* Katydid's own process is created for ROOT/Cling's autoload
# machinery to see it at all -- fixed by :katydid_launcher.sh/:root_include_path_wrapper.sh
# above. See check_katydid_stderr_test.sh's own header for the full explanation of both
# symptoms, including why the first one failed differently on the two platforms.
sh_test(
    name = "katydid_stderr_test",
    srcs = ["check_katydid_stderr_test.sh"],
    args = ["$(location :Katydid)"],
    data = [":Katydid"],
)
