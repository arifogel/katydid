# Builds the Katydid and Truncate command-line programs. Both link against every Katydid
# module, matching how they are built in the CMake/Docker workflow.
#
# EggScanner and RSAMatToEgg are not built here: both require Monarch (Katydid's raw egg-file
# reading library), which is off by Katydid's default configuration.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":harvest_runtime_libs.bzl", "harvest_runtime_libs")
load(":release_binary.bzl", "release_binary")
load(":root_include_path_launcher.bzl", "root_include_path_launcher")

package(default_visibility = ["//visibility:public"])

# Referenced by //:katydid_release. Source files need exports_files() to be visible outside
# this package.
exports_files(["NOTICE.txt"])

# Headers: for compile-time visibility of whatever Katydid.cc/Truncate.cc #include.
_ALL_KATYDID_HEADERS = [
    "//Source/Data:katydid_data_headers",
    "//Source/EventAnalysis:katydid_event_analysis_headers",
    "//Source/IO:katydid_io_headers",
    "//Source/SpectrumAnalysis:katydid_spectrum_analysis_headers",
    "//Source/Transform:katydid_transform_headers",
    "//Source/Utility:katydid_utility_headers",
    "@cicada//:cicada_headers",
]

# The actual .so's: for the runtime link. Every module here is now a real, standalone .so
# that carries its own ROOT dictionary code directly (IODict_cxx/CicadaDict_cxx/UtilityDict_cxx
# are compiled into katydid_io/cicada/katydid_utility themselves, not a separate artifact) --
# each is a valid dlopen() target for TCling::RegisterModule on its own, so no separate
# libroot_dict_shared.so/root_dict_import/katydid_io_root_types mechanism is needed anymore.
_ALL_KATYDID_LIBS = [
    "//Source/Data:katydid_data",
    "//Source/EventAnalysis:katydid_event_analysis",
    "//Source/IO:katydid_io",
    "//Source/SpectrumAnalysis:katydid_spectrum_analysis",
    "//Source/Transform:katydid_transform",
    "//Source/Utility:katydid_utility",
    "@cicada",
    "@nymph",
    "@scarab",
]

# Cling looks for a dictionary's _rdict.pcm file directly alongside the running binary.
# katydid_io/@cicada/katydid_utility declare `data = [":<name>_pcm"]` on their own cc_library,
# but that only places the PCM in the runfiles tree, not next to the binary. Without this,
# Cling falls back to re-parsing the dictionary's embedded payload at runtime and crashes when
# it can't find the PCM -- the same crash Source/Executables/Validation:TestTrackProcessing
# and :TestSequentialTrackFinder hit. Fixed the same way here: copy each PCM into this
# package's own bazel-out bin/ directory.
genrule(
    name = "IODict_pcm_local_copy",
    srcs = ["//Source/IO:IODict_pcm"],
    outs = ["IODict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

genrule(
    name = "CicadaDict_pcm_local_copy",
    srcs = ["@cicada//:CicadaDict_pcm"],
    outs = ["CicadaDict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

genrule(
    name = "UtilityDict_pcm_local_copy",
    srcs = ["//Source/Utility:UtilityDict_pcm"],
    outs = ["UtilityDict_gen_rdict.pcm"],
    cmd = "cp $< $@",
)

_ALL_PCM_DATA = [
    ":IODict_pcm_local_copy",
    ":CicadaDict_pcm_local_copy",
    ":UtilityDict_pcm_local_copy",
]

cc_binary(
    name = "Katydid_bin",
    srcs = ["Katydid.cc"],
    data = _ALL_PCM_DATA,
    dynamic_deps = _ALL_KATYDID_LIBS,
    deps = _ALL_KATYDID_HEADERS,
)

cc_binary(
    name = "Truncate_bin",
    srcs = ["Truncate.cc"],
    data = _ALL_PCM_DATA,
    dynamic_deps = _ALL_KATYDID_LIBS,
    deps = _ALL_KATYDID_HEADERS,
)

root_include_path_launcher(
    name = "Katydid",
    real_bin_label = ":Katydid_bin",
)

root_include_path_launcher(
    name = "Truncate",
    real_bin_label = ":Truncate_bin",
)

# Separate from :Katydid/:Truncate above: those are built for `bazel run`/`bazel test`, wired
# to Bazel's own runfiles tree via root_include_path_launcher.bzl's rlocation-based mechanism.
# These are for //:katydid_release's own flat bin/ + lib/ + root/ archive layout instead - see
# release_binary.bzl's own docstring for why a separate binary/wrapper pair is needed rather
# than reusing the ones above.
release_binary(
    name = "Katydid_release",
    real_bin_label = ":Katydid_bin",
)

release_binary(
    name = "Truncate_release",
    real_bin_label = ":Truncate_bin",
)

# Every non-@root .so/.pcm either binary needs at runtime, harvested straight from Bazel's own
# dependency graph - not hand-listed, so it can't go stale the way an explicit list could (see
# harvest_runtime_libs.bzl's own docstring). ROOT itself is bundled separately and wholesale
# (see //tools:root.bzl's own all_files filegroup) into //:katydid_release's own root/
# subdirectory, not here.
harvest_runtime_libs(
    name = "release_libs",
    binaries = [
        ":Katydid_bin",
        ":Truncate_bin",
    ],
)

# Regression test for two fixed bugs: TCling::RegisterModule dlopen()-ing Katydid's own main
# executable (fixed by every module being a real, standalone .so, each a valid dlopen()
# target on its own), and ROOT_INCLUDE_PATH needing to be set before Katydid's process starts
# (fixed in root_include_path_launcher.bzl). See check_katydid_stderr_test.sh's own header for
# details.
sh_test(
    name = "katydid_stderr_test",
    srcs = ["check_katydid_stderr_test.sh"],
    args = ["$(location :Katydid)"],
    data = [":Katydid"],
)
