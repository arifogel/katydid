# Builds the packaged release archive (//:katydid_release) and exposes the repo-root files it
# needs (LICENSE, third_party_licenses/).
#
# Layout: bin/Katydid (a portable wrapper script) execs bin/Katydid_bin (the real, RPATH-
# patched binary) - same for Truncate. lib/ is flat: every Katydid module .so, Cicada/Nymph/
# Scarab/yaml-cpp, and their dictionary PCMs, sitting directly beside the .so each PCM belongs
# to - harvested automatically from Katydid_bin/Truncate_bin's runfiles (see
# //Source/Executables/Main:harvest_runtime_libs.bzl). ROOT is bundled wholesale, unfiltered,
# into a separate root/ subdirectory (see //tools:root.bzl's all_files filegroup), kept
# separate from lib/: ROOT's runtime needs a real, complete install layout (bin/, lib/, etc/,
# include/) to find things like etc/gitinfo.txt and dlopen()-load libCling.so.
#
# On AlmaLinux, Boost/FFTW/MatIO/TBB/xxhash/FreeType/GSL are all bundled into lib/ too
# (Boost/FFTW via the harvest above, since they're a real Bazel dependency there; the other
# four - never anything's dependency, just ROOT's own runtime need - via
# katydid_release_root_runtime_extra_libs below, which @binary_deps//:root_runtime_extra_libs
# is empty everywhere except AlmaLinux, so this needs no platform-specific select() of its
# own). Elsewhere, Boost/FFTW are resolved via plain system linker paths - see NOTES.md for
# status.

load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:private"])

exports_files(["LICENSE"])

filegroup(
    name = "third_party_licenses",
    srcs = glob(["third_party_licenses/*.txt"]),
)

# NOTICE.txt lives at //Source/Executables/Main (see there). Included here at the archive's
# top level, next to LICENSE.
pkg_files(
    name = "katydid_release_notices",
    srcs = [
        "LICENSE",
        "//Source/Executables/Main:NOTICE.txt",
    ],
)

pkg_files(
    name = "katydid_release_third_party_licenses",
    srcs = [":third_party_licenses"],
    prefix = "third_party_licenses",
)

# bin/Katydid, bin/Katydid_bin, bin/Truncate, bin/Truncate_bin - renamed from their build
# target names (Katydid_release/Katydid_release_bin/etc.) since Katydid/Katydid_bin were
# already taken by the bazel run/bazel test variants in the same package (see
# //Source/Executables/Main:BUILD.bazel's comment on release_binary()).
pkg_files(
    name = "katydid_release_bin",
    srcs = [
        "//Source/Executables/Main:Katydid_release",
        "//Source/Executables/Main:Katydid_release_bin",
        "//Source/Executables/Main:Truncate_release",
        "//Source/Executables/Main:Truncate_release_bin",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "bin",
    renames = {
        "//Source/Executables/Main:Katydid_release": "Katydid",
        "//Source/Executables/Main:Katydid_release_bin": "Katydid_bin",
        "//Source/Executables/Main:Truncate_release": "Truncate",
        "//Source/Executables/Main:Truncate_release_bin": "Truncate_bin",
    },
)

# lib/*.so, lib/*.pcm - flat, harvested automatically (see the harvest_runtime_libs target's
# docstring for why this isn't a hand-maintained list).
pkg_files(
    name = "katydid_release_lib",
    srcs = ["//Source/Executables/Main:release_libs"],
    prefix = "lib",
    strip_prefix = strip_prefix.from_pkg("release_libs"),
)

# root/ - ROOT's tarball, wholesale and unfiltered (see this file's top comment for why it
# isn't merged into lib/ above).
pkg_files(
    name = "katydid_release_root",
    srcs = ["@root//:all_files"],
    prefix = "root",
    strip_prefix = strip_prefix.from_pkg("root"),
)

# include/ is just the headers needed at runtime; see root_include_path_launcher.bzl's
# _CICADA_DICT_HEADERS for which ones and why.
#
# It's not a full install layout downstream code could build against as in the cmake
# reference install layout - every other Katydid/Nymph/Scarab header is still missing. See
# NOTES.md's "Known limitations" section.
pkg_files(
    name = "katydid_release_include",
    srcs = [
        "@cicada//:Library/CClassifierResultsData.hh",
        "@cicada//:Library/CMTEWithClassifierResultsData.hh",
        "@cicada//:Library/CMemberVariables.hh",
        "@cicada//:Library/CProcessedMPTData.hh",
        "@cicada//:Library/CROOTData.hh",
        "@cicada//:Library/_CROOTData.hh",
    ],
    prefix = "include",
    strip_prefix = strip_prefix.from_pkg("Library"),
)

# lib/ extras: TBB/xxhash/FreeType/GSL, needed only because ROOT's own prebuilt binaries link
# against them - ROOT's own tarball above doesn't bundle them (see tools/almalinux_libs.bzl).
# Nothing in this build `deps` on these, so harvest_runtime_libs.bzl's runfiles walk never finds
# them; listed here directly instead. Empty except on AlmaLinux (see tools/binary_deps.bzl).
pkg_files(
    name = "katydid_release_root_runtime_extra_libs",
    srcs = ["@binary_deps//:root_runtime_extra_libs"],
    prefix = "lib",
)

pkg_tar(
    name = "katydid_release",
    srcs = [
        ":katydid_release_bin",
        ":katydid_release_include",
        ":katydid_release_lib",
        ":katydid_release_notices",
        ":katydid_release_root",
        ":katydid_release_root_runtime_extra_libs",
        ":katydid_release_third_party_licenses",
    ],
    extension = "tar.gz",
    visibility = ["//visibility:public"],
)
