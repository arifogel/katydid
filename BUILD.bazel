# Builds the packaged release archive (//:katydid_release) and exposes the repo-root files it
# needs (LICENSE, third_party_licenses/).

load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

filegroup(
    name = "third_party_licenses",
    srcs = glob(["third_party_licenses/*.txt"]),
)

# NOTICE.txt lives at //Source/Executables/Main, not here: its warning is specifically about
# the compiled binaries in the release archive below, not about this source repository
# (which is fine to share, per the notice's own first paragraph) -- keeping it next to the
# targets that actually build and bundle those binaries avoids it being mistaken for a
# blanket statement about the whole repo if someone just browses the source tree.
#
# In the archive itself, both NOTICE.txt and Katydid's own LICENSE sit at the top level, next
# to the binaries -- maximally visible to anyone who opens the archive. See NOTICE.txt for
# the full explanation: to the best of our knowledge (NOT a legal determination),
# distributing the compiled binaries in this archive likely violates FFTW's GPL license,
# since Katydid's own license isn't GPL-compatible.
pkg_files(
    name = "katydid_release_notices",
    srcs = [
        "LICENSE",
        "//Source/Executables/Main:NOTICE.txt",
    ],
)

# Every third-party license this binary is actually subject to (see NOTICE.txt), collected
# under a clearly-named subdirectory rather than flattened alongside everything else.
pkg_files(
    name = "katydid_release_third_party_licenses",
    srcs = [":third_party_licenses"],
    prefix = "third_party_licenses",
)

# Katydid/Truncate (the launcher scripts) plus their own complete, correct runfiles --
# Katydid_bin/Truncate_bin (the real binaries each launcher execs), libroot_dict_shared.so (a
# genuine runtime shared-library dependency of those real binaries), and every file Cling's
# runtime dictionary/autoloading machinery needs (see //Source/Executables/Main's own
# comments for why each of these exists) -- via include_runfiles, rather than a manually-
# maintained file list that has to be kept in sync by hand as files are added or removed.
# Extracting this archive anywhere and running ./Katydid from that directory reproduces
# exactly the runfiles layout those mechanisms expect (see
# //Source/Executables/Main:root_include_path_launcher.bzl, which locates everything it
# needs through that same layout, not a flat, hand-assumed one).
#
# excludes the two *_launcher_gen.sh genrule outputs: sh_binary's own rule implementation
# puts both the named launcher stub and its own srcs file (that genrule output) into
# DefaultInfo.files, so packaging :Katydid/:Truncate directly would duplicate each one at
# this archive's own top level, alongside the real, working copy inside .runfiles/ that
# include_runfiles already captures -- confirmed directly, both by reading
# rules_shell's own sh_executable.bzl (direct_files = [src, symlink]/[src] + [entrypoint])
# and by extracting a built archive and finding both files there. Confirmed harmless but
# genuinely unnecessary: the generated launcher's own content resolves the real binary via
# rlocation (a runfiles-tree lookup, with no notion of a sibling file at all), so the
# top-level copy of the genrule output serves no purpose there.
pkg_files(
    name = "katydid_release_binaries",
    srcs = [
        "//Source/Executables/Main:Katydid",
        "//Source/Executables/Main:Truncate",
    ],
    excludes = [
        "//Source/Executables/Main:Katydid_launcher_gen.sh",
        "//Source/Executables/Main:Truncate_launcher_gen.sh",
    ],
    include_runfiles = True,
)

# Does NOT bundle ROOT/Boost/FFTW/etc: those are dynamically linked at fixed absolute paths
# (e.g. /opt/homebrew/opt/root/lib/root/libCore.so) and are assumed to already be present,
# in compatible versions, on any machine this archive is extracted on -- packaging shared
# library dependencies themselves is a separate, materially larger undertaking this doesn't
# attempt.
pkg_tar(
    name = "katydid_release",
    srcs = [
        ":katydid_release_binaries",
        ":katydid_release_notices",
        ":katydid_release_third_party_licenses",
    ],
    extension = "tar.gz",
)
