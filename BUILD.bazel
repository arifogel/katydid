# Builds the packaged release archive (//:katydid_release) and exposes the repo-root files it
# needs (LICENSE, third_party_licenses/).

load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

filegroup(
    name = "third_party_licenses",
    srcs = glob(["third_party_licenses/*.txt"]),
)

# NOTICE.txt lives at //Source/Executables/Main (see there). Included here at the archive's
# top level, next to LICENSE.
pkg_files(
    name = "katydid_release_notices",
    srcs = [
        "LICENSE",
        "//Source/Executables/Main:NOTICE.txt",
    ],
)

pkg_files(
    name = "katydid_release_third_party_licenses",
    srcs = [":third_party_licenses"],
    prefix = "third_party_licenses",
)

# include_runfiles: Katydid_bin/Truncate_bin need their own runfiles tree (ROOT dictionary
# PCM files, every Katydid module's own .so, etc.) at runtime -- see
# //Source/Executables/Main:root_include_path_launcher.bzl.
#
# Does not bundle ROOT/Boost/FFTW/etc: dynamically linked at fixed absolute paths, assumed
# present on the target machine.
pkg_tar(
    name = "katydid_release",
    srcs = [
        ":katydid_release_notices",
        ":katydid_release_third_party_licenses",
        "//Source/Executables/Main:Katydid",
        "//Source/Executables/Main:Truncate",
    ],
    extension = "tar.gz",
    include_runfiles = True,
)
