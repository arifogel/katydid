module(
    name = "katydid",
    version = "0.1.0",
)

# --- Bazel Central Registry deps -------------------------------------------

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.0.0")

# --- Non-Bazel-native git dependencies (Nymph, Scarab, Cicada, rapidjson, yaml-cpp) ---
# Pinned to the exact commits recorded by `git submodule status` in the katydid checkout
# this was derived from (branch feature/FreqDomainInput). See tools/non_bazel_deps.bzl.

non_bazel_deps = use_extension("//tools:non_bazel_deps.bzl", "non_bazel_deps")
use_repo(non_bazel_deps, "nymph", "scarab", "rapidjson", "yaml_cpp")
# "cicada" deliberately not wired in yet - it needs the rootcling/ROOT_GENERATE_DICTIONARY
# genrule support, which is the next step after this slice is confirmed working.

# --- Homebrew-provided system libraries (Boost, FFTW; ROOT/MatIO come in a later step) ---
# Not hermetic across machines - this is a deliberate trade for a zero-configure dev loop.
# See tools/homebrew.bzl for the reasoning and how to tighten this later.

homebrew_deps = use_extension("//tools:homebrew.bzl", "homebrew_deps")
use_repo(homebrew_deps, "homebrew")
