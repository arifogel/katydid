module(
    name = "katydid",
    version = "0.1.0",
)

# --- Bazel Central Registry deps -------------------------------------------

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.0.0")

# --- Non-Bazel-native git dependencies (Nymph, Scarab, Cicada, rapidjson, yaml-cpp) ---
# Pinned to the exact commits recorded by `git submodule status` in the katydid checkout
# this was derived from (branch feature/FreqDomainInput). See tools/non_bazel_deps.bzl.

non_bazel_deps = use_extension("//tools:non_bazel_deps.bzl", "non_bazel_deps")
use_repo(non_bazel_deps, "cicada", "nymph", "rapidjson", "scarab", "yaml_cpp")

# --- System-provided libraries (Boost, FFTW, MatIO, ROOT) ---
# Not hermetic across machines - a deliberate trade for a zero-configure dev loop. Homebrew on
# macOS, apt on Linux, ROOT via root-config on PATH regardless of OS.
# See tools/system_deps.bzl for the reasoning and how to tighten this later.

homebrew_deps = use_extension("//tools:system_deps.bzl", "homebrew_deps")
use_repo(homebrew_deps, "homebrew")
