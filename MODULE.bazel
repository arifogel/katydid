module(
    name = "katydid",
    version = "0.1.0",
)

# --- Bazel Central Registry dependencies ------------------------------------

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "patchelf", version = "0.19.1")

# --- Katydid's git-based dependencies (Nymph, Scarab, Cicada, rapidjson, yaml-cpp) ----------
# None of these have native Bazel support, so each is fetched as a pinned git commit and paired
# with a hand-written BUILD file under third_party/. Pins should be kept in sync with whatever
# commits the project's canonical CMake build (via git submodules, for Nymph/Scarab/Cicada) is
# actually using. See tools/non_bazel_deps.bzl for details.

non_bazel_deps = use_extension("//tools:non_bazel_deps.bzl", "non_bazel_deps")
use_repo(non_bazel_deps, "cicada", "nymph", "rapidjson", "scarab", "yaml_cpp")

# --- ROOT ------------------------------------------------------------------------------
# Fetched as a prebuilt binary from root.cern for the current platform - see tools/root.bzl
# for details, and BUILDING.md for supported platforms.

root_deps = use_extension("//tools:root.bzl", "root_deps")
use_repo(root_deps, "root")

# --- System-provided scientific libraries (Boost, FFTW, MatIO) -----------------------------
# These are located on the host machine rather than built by Bazel - see tools/system_deps.bzl
# for how each is found on macOS, Ubuntu, and AlmaLinux/RHEL-family Linux, and BUILDING.md for
# what needs to be installed on each platform before building.

system_deps = use_extension("//tools:system_deps.bzl", "system_deps")
use_repo(system_deps, "system_libs")

# --- Boost/FFTW/TBB/xxhash/FreeType/GSL, fetched hermetically on AlmaLinux 9 ----------------
# Pinned .rpm packages, unpacked by Bazel itself - see tools/rpm_deps.bzl. Selected instead of
# @system_libs above only on AlmaLinux (see tools/host_platform.bzl and Source/Utility/
# BUILD.bazel's select()).

rpm_deps = use_extension("//tools:rpm_deps.bzl", "rpm_deps")
use_repo(rpm_deps, "rpm_deps")

# --- Host platform detection (Linux distro) ------------------------------------------------
# Extends Bazel's auto-detected host platform with an AlmaLinux constraint_value, so the
# select() above needs no --config/--define flag - see tools/host_platform.bzl and .bazelrc's
# --platforms default.

host_platform = use_extension("//tools:host_platform.bzl", "host_platform")
use_repo(host_platform, "host_platform")
