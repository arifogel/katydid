module(
    name = "katydid",
    version = "0.1.0",
)

# --- Bazel Central Registry dependencies ------------------------------------

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "patchelf", version = "0.19.1")

# --- Katydid's git-based dependencies (Nymph, Scarab, Cicada, rapidjson, yaml-cpp) ----------
# None of these have native Bazel support, so each is fetched as a pinned git commit and paired
# with a hand-written BUILD file under third_party/. Pins should be kept in sync with whatever
# commits the project's canonical CMake build (via git submodules, for Nymph/Scarab/Cicada) is
# actually using. See tools/non_bazel_deps.bzl for details.

non_bazel_deps = use_extension("//tools:non_bazel_deps.bzl", "non_bazel_deps")
use_repo(non_bazel_deps, "cicada", "nymph", "rapidjson", "scarab", "yaml_cpp")

# --- ROOT ------------------------------------------------------------------------------
# Fetched as a prebuilt binary from root.cern for the current platform - see tools/root.bzl
# for details, and BUILDING.md for supported platforms.

root_deps = use_extension("//tools:root.bzl", "root_deps")
use_repo(root_deps, "root")

# --- Scientific libraries (Boost, FFTW, MatIO, + AlmaLinux's ROOT-runtime extras) ----------
# One retrieval repo per platform (tools/macos_libs.bzl, tools/ubuntu_libs.bzl,
# tools/almalinux_libs.bzl - Homebrew/apt discovery on macOS/Ubuntu, a hermetic pinned fetch on
# AlmaLinux), resolved to a single @binary_deps label surface by tools/binary_deps.bzl - see
# that file for how, and BUILDING.md for what needs to be installed on each platform.

macos_libs = use_extension("//tools:macos_libs.bzl", "macos_libs")
use_repo(macos_libs, "macos_libs")

ubuntu_libs = use_extension("//tools:ubuntu_libs.bzl", "ubuntu_libs")
use_repo(ubuntu_libs, "ubuntu_libs")

almalinux_libs = use_extension("//tools:almalinux_libs.bzl", "almalinux_libs")
use_repo(almalinux_libs, "almalinux_libs")

binary_deps = use_extension("//tools:binary_deps.bzl", "binary_deps")
use_repo(binary_deps, "binary_deps")
