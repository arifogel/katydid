module(
    name = "katydid",
    version = "0.1.0",
)

# --- Bazel Central Registry dependencies ------------------------------------

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.0.0")

# --- Katydid's own git-based dependencies (Nymph, Scarab, Cicada, rapidjson, yaml-cpp) ------
# None of these have native Bazel support, so each is fetched as a pinned git commit and paired
# with a hand-written BUILD file under third_party/. Pins should be kept in sync with whatever
# commits the project's canonical CMake build (via git submodules, for Nymph/Scarab/Cicada) is
# actually using. See tools/non_bazel_deps.bzl for details.

non_bazel_deps = use_extension("//tools:non_bazel_deps.bzl", "non_bazel_deps")
use_repo(non_bazel_deps, "cicada", "nymph", "rapidjson", "scarab", "yaml_cpp")

# --- System-provided scientific libraries (ROOT, Boost, FFTW, MatIO) -----------------------
# These are located on the host machine rather than built by Bazel - see tools/system_deps.bzl
# for how each is found on macOS, Ubuntu, and AlmaLinux/RHEL-family Linux, and BUILDING.md for
# what needs to be installed on each platform before building.

system_deps = use_extension("//tools:system_deps.bzl", "system_deps")
use_repo(system_deps, "system_libs")
