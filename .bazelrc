# ROOT (Homebrew 6.38/6.40) hard-requires C++17 - see NOTES.md. C++17 is a strict superset
# for this ~2018-era C++11 codebase (Nymph/Scarab/Katydid), so bumping globally rather than
# special-casing ROOT-touching targets. Don't also set -std=c++11 in any target's `copts` -
# that would win over this on the actual compile line and reintroduce the mismatch.
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# Makes `bazel build ...` and CLion's Bazel plugin agree on what "everything" means.
build --curses=yes
# Fail builds/tests if MODULE.bazel and MODULE.bazel.lock are out of sync
common --lockfile_mode=error
