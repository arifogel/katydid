# Katydid's own code, Nymph, and Scarab predate C++17 and only require C++11, but ROOT itself
# requires C++17 or newer to compile against. C++17 is a strict superset of the C++11 features
# this codebase actually uses, so the whole build is compiled as C++17 rather than special-
# casing the handful of targets that touch ROOT headers directly.
#
# Do not set -std=c++11 (or any other -std flag) in any target's `copts` in a BUILD.bazel file:
# a flag set there is applied after this one on the actual compile command line, so it would
# silently override this and reintroduce the ROOT build failure.
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# Keeps `bazel build ...`'s console output and CLion's Bazel plugin in agreement about what
# "everything" means.
build --curses=yes

# Fails the build if MODULE.bazel and MODULE.bazel.lock have drifted out of sync with each
# other, instead of silently proceeding against a stale lockfile. Run
# `bazel mod deps --lockfile_mode=update` to regenerate the lockfile after changing MODULE.bazel.
common --lockfile_mode=error
